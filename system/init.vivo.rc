# vivo wangguanyu add for survival mode, if boot completed then remove the package begin
on property:sys.boot_completed=1
    rm /data/vivo-others/survival/vivo-survival_1.0-UpdateFull_package.zip
    rm /data/vivo-others/survival/vivo-survival_1.0-UpdateFull_package.zip.aria2
    rm /data/vivo-others/survival/vivo-survival_1.0-UpdateFull_package.zip.aria2__temp
# vivo wangguanyu add for survival mode, if boot completed then remove the package end

# vivo jupengfei add for perfetto_ksyms begin
on property:persist.sys.systrace.state=on
    write /proc/sys/kernel/kptr_restrict 0

on property:persist.sys.systrace.state=off
    write /proc/sys/kernel/kptr_restrict 2
# vivo jupengfei add for perfetto_ksyms end

# vivo jupengfei add for coredump begin
on property:persist.sys.log.coredump=1
    mkdir /data/bbklog/coredump
    write /proc/sys/fs/suid_dumpable 1
    write /proc/sys/kernel/core_pattern "/data/bbklog/coredump/core-%e-%p-%u-%t"

on property:persist.sys.log.coredump=0
    write /proc/sys/fs/suid_dumpable 0
    write /proc/sys/kernel/core_pattern ""
# vivo jupengfei add for coredump end

