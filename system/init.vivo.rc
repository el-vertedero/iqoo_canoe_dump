     socket dumpstate stream 0660 shell system
     class main
     user root
     disabled
     oneshot

service copy_bugreport_log /system/bin/sh -c "cp -rf /data/user_de/0/com.android.shell/files/bugreports /storage/emulated/0/bugreports;rm -rf /data/user_de/0/com.android.shell/files/bugreports/*"
     disabled
     user shell
     group shell system
     seclabel u:r:shell:s0
     oneshot
