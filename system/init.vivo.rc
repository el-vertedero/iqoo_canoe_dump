# JuPengfei CopyLog add
on property:sys.bbklog.copy=1
#Android R only
   exec u:r:shell:s0 shell shell -- /system/bin/cp -r --preserve=timestamps /data/vendor/audiohal/audio_dump /sdcard/audio_dump
   setprop sys.bbklog.copy 0

on property:sys.bbklog.copy=2
   exec u:r:shell:s0 root system sdcard_rw media_rw everybody -- /system/bin/cp -r --preserve=timestamps /data/vendor/aee_exp /sdcard/vendor_aee
   exec u:r:shell:s0 root system sdcard_rw media_rw everybody -- /system/bin/cp -r --preserve=timestamps /data/aee_exp /sdcard/data_aee
   setprop sys.bbklog.copy 0

on property:sys.bbklog.copy=3
   exec u:r:shell:s0 root system -- /system/bin/cp -r /data/vendor/tombstones/SDX50M /sdcard/SDX50M
   exec u:r:shell:s0 root system -- /system/bin/cp -r /data/vendor/tombstones/SDX55M /sdcard/SDX55M
   setprop sys.bbklog.copy 0

on property:sys.bbklog.copy=4
   exec u:r:shell:s0 root system -- /system/bin/cp -r /data/vendor/tombstones/SDX50M/OCIMEM.BIN /sdcard/OCIMEM.BIN
   exec u:r:shell:s0 root system -- /system/bin/cp -r /data/vendor/tombstones/SDX55M/OCIMEM.BIN /sdcard/OCIMEM.BIN

on property:sys.bbklog.copy=5
    exec u:r:shell:s0 root system -- /system/bin/rm -r /data/vendor/tombstones/SDX50M/
    exec u:r:shell:s0 root system -- /system/bin/rm -r /data/vendor/tombstones/SDX55M/

on property:sys.bbklog.copy=6
   exec u:r:system_server:s0 system root -- /system/bin/cp -rf --preserve=timestamps /data/system/dropbox /data/dropbox_tmp
   setprop sys.bbklog.copy 0

on property:sys.bbklog.copy=7
   exec u:r:system_server:s0 system root -- /system/bin/rm -rf /data/dropbox_tmp
   exec u:r:system_server:s0 system root -- /system/bin/rm -rf /data/bbklog/dropbox_tmp
   setprop sys.bbklog.copy 0

on property:sys.bbklog.copy=8
   exec u:r:system_server:s0 system root -- /system/bin/cp -rf --preserve=timestamps /data/system/dropbox /data/bbklog/dropbox_tmp
   setprop sys.bbklog.copy 0

on property:sys.bbklog.copy=10
   exec u:r:shell:s0 root system -- /system/bin/cp -r --preserve=timestamps /data/vendor/camera/dump /sdcard/dumpyuv
   setprop sys.bbklog.copy 0

on property:sys.bbklog.copy=9
   exec u:r:shell:s0 root system -- /system/bin/rm -rf /data/vendor/camera/dump

# MTK copy aee begin
on property:sys.bbklog.copy=11
    exec u:r:shell:s0 root system sdcard_rw media_rw everybody -- /system_ext/bin/aeedb cp ${sys.aee.db.type} ${sys.aee.db.path} ${sys.aee.db.time}
    exec u:r:shell:s0 root system sdcard_rw media_rw everybody -- /system_ext/bin/aeedb_v2 cp ${sys.aee.db.type} ${sys.aee.db.path} ${sys.aee.db.time}
    setprop sys.bbklog.copy 0
# MTK copy aee end

# end

# vivo xushiming add for limit log size begin
on property:sys.bbklog.limitsize=1
    exec u:r:shell:s0 shell log -- /bin/sh /system/etc/vivo.bbklog.limitsize.sh
    setprop sys.bbklog.limitsize 0

on property:sys.bbklog.clearlog=1
    exec u:r:shell:s0 shell log -- /bin/sh /system/etc/vivo.bbklog.clearlog.sh ${sys.bbklog.clear.keep_time}
    setprop sys.bbklog.clearlog 0
# vivo xushiming add for limit log size end

# vivo linbailu add for PDPB
on property:ro.vendor.have_aeev_feature=0 && property:sys.boot_completed=1
   exec u:r:shell:s0 root system -- /system/bin/rm -rf /data/vendor/aee_exp
   exec u:r:shell:s0 root system -- /system/bin/rm -rf /data/aee_exp
# end

# vivo jupengfei add for diag_mdlog begin
on property:sys.mdlog.start=1
   exec_background u:r:vendor_qlogd:s0 root system -- /vendor/bin/diag_mdlog ${sys.mdlog.start_param}
   setprop sys.mdlog.start 0

on property:sys.mdlog.start=2
   exec_background u:r:vendor_qlogd:s0 root system -- /vendor/bin/diag_dci_sample_vendor_start
   setprop sys.mdlog.start 0

on property:sys.mdlog.stop=1
   exec u:r:vendor_qlogd:s0 root system -- /vendor/bin/diag_mdlog ${sys.mdlog.stop_param}
   setprop sys.mdlog.stop 0

on property:sys.mdlog.stop=2
   exec_background u:r:vendor_qlogd:s0 root system -- /vendor/bin/diag_dci_sample_vendor
   setprop sys.mdlog.stop 0
# vivo jupengfei add for diag_mdlog end

# vivo jupengfei add for vendor_log_ctrl begin
on property:persist.sys.log.ctrl=yes
    setprop persist.vendor.log.ctrl yes

on property:persist.sys.log.ctrl=no
    setprop persist.vendor.log.ctrl no
# vivo jupengfei add for vendor_log_ctrl end

# vivo jupengfei add for aee begin
on property:sys.bbklog.aee=1
   setprop persist.vendor.mtk.aee.crash.exp 0

on property:sys.bbklog.aee=2
   setprop persist.vendor.mtk.aee.anr.exp 0

on property:sys.bbklog.aee=0
   setprop persist.vendor.mtk.aee.crash.exp 1
   setprop persist.vendor.mtk.aee.anr.exp 1
# vivo jupengfei add for aee end

# vivo luojiawei add for diag_mdlog begin
on property:sys.nimdlog.start=1
   exec_background u:r:vendor_qlogd:s0 root system -- /vendor/bin/diag_mdlog -t 2 -p 2 -d -c -o /storage/emulated/0/.networkstate/bbk_log/ -f /storage/emulated/0/.networkstate_config_file/diag.cfg
   setprop sys.nimdlog.start 0

on property:sys.nimdlog.start=2
   exec_background u:r:vendor_qlogd:s0 root system -- /vendor/bin/diag_dci_sample_vendor_start
   setprop sys.nimdlog.start 0

on property:sys.nimdlog.stop=1
   exec u:r:vendor_qlogd:s0 root system -- /vendor/bin/diag_mdlog ${sys.nimdlog.stop_param}
   setprop sys.nimdlog.stop 0

on property:sys.nimdlog.stop=2
   exec_background u:r:vendor_qlogd:s0 root system -- /vendor/bin/diag_dci_sample_vendor
   setprop sys.nimdlog.stop 0

on property:sys.nimdlog.stop=3
   exec_background u:r:vendor_qlogd:s0 root system -- /vendor/bin/diag_mdlog -p 2 -k
   setprop sys.nimdlog.stop 0
# vivo luojiawei add for diag_mdlog end

