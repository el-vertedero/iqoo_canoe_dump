    chown system system /mnt/vendor/persist/camera/bestmoment_gpu64.bin
    chown system system /mnt/vendor/persist/camera/bestmoment_gpu_fp64.bin
    #for mtk
    chown system system /mnt/vendor/nvcfg/camera/bestmoment_gpu64.bin
    chown system system /mnt/vendor/nvcfg/camera/bestmoment_gpu_fp64.bin
    #vivo luotao add for motion capture 4.0 end

    #vivo wanglimin add for VIVO_ESIM begin
    chown root radio /proc/esim
    chmod 0660 /proc/esim
    #vivo wanglimin add for VIVO_ESIM end

    #vivo songjunlin add for spi_ir begin
    chown system system /dev/kookong
    chmod 0666 /dev/kookong
    #vivo songjunlin add for spi_ir end

    #vivo linzesheng add for zcache begin
    chown system system /dev/vivo_mem_scene
    chown system system /sys/zcache/prio
    chown system system /sys/zcache/stored_enable
    chown system system /sys/zcache/version
    chown system system /sys/zcache/shrink
    chown system system /sys/zcache/bindcore
    chown system system /proc/zcache
    chown system system /proc/zcache_quick
    #vivo linzesheng add for zcache end

    #vivo linzesheng add for media dma begin
    chown system system /sys/media/status
    chown system system /sys/media/enabled
    chown system system /sys/media/writelimit
    chmod 0777 /dev/dmsr_ctl
    chown system system /dev/dmsr_ctl
    #vivo linzesheng add for media dma end

    #vivo linzesheng add for gc boost begin
    chmod 0777 /dev/gc_boost
    chown system system /dev/gc_boost
    #vivo linzesheng add for gc boost end

    # vivo linzhichi add for vccontrol begin
    chmod 0666 /dev/vccontrol_info
    # vivo linzhichi add for vccontrol end


