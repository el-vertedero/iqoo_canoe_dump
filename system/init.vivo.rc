on property:persist.vivo.logsystem.cpswt=1
    exec u:r:shell:s0 system system debuggerd -- /system/bin/cp -r --preserve=timestamps /data/aee_exp /data/logData/dbg
    setprop persist.vivo.logsystem.cpswt 0

on property:persist.vivo.logsystem.cpswt=2
