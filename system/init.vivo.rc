    chmod 0664 /sys/class/cms_class/soh_test
    chown system system /sys/class/cms_class/soh_test_ocv_soc
    chmod 0664 /sys/class/cms_class/soh_test_ocv_soc
    chown system system /sys/class/cms_class/soh_loss_event_info
    chmod 0664 /sys/class/cms_class/soh_loss_event_info
    chown system system /sys/class/cms_class/loss_sw_lh_info
    chmod 0664 /sys/class/cms_class/loss_sw_lh_info
    chown system system /sys/class/cms_class/dcr_eis_info
    chmod 0664 /sys/class/cms_class/dcr_eis_info
