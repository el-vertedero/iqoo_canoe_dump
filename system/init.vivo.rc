# vivo aichen add for setting security prop begin
on property:ro.vivo.product.overseas=*
    setprop ro.vendor.defend.product.overseas ${ro.vivo.product.overseas}

on property:ro.vivo.dyn.veritystate=*
    setprop ro.vendor.defend.dyn.veritystate ${ro.vivo.dyn.veritystate}

