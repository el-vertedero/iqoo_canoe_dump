#init.rc for vivo

import /init.vivo.project.rc
import /init.vivo.platform.rc
import /init.vivo.soc.rc
import /init.vivo.common.rc
import /vgc/vgc.rc
import /vendor/vgc/vgc.rc
import /mnt/vendor/vgc/vgc.rc
import /vendor/etc/init/hw/init.factory.rc
import /system/etc/init/hw/init.vivo.zygote64.rc

import /init.${ro.vivo.project}.rc

on init
    # vivo yangyang add begin
    write /sys/block/sda/queue/scheduler vkyber
    write /sys/block/sdb/queue/scheduler vkyber
    write /sys/block/sdc/queue/scheduler vkyber
    write /sys/block/sdd/queue/scheduler vkyber
    write /sys/block/sde/queue/scheduler vkyber
    write /sys/block/sdf/queue/scheduler vkyber
    write /sys/block/sdg/queue/scheduler vkyber

    write /sys/block/sda/queue/nr_requests 96
    write /sys/block/sdb/queue/nr_requests 96
    write /sys/block/sdc/queue/nr_requests 96
    write /sys/block/sdd/queue/nr_requests 96
    write /sys/block/sde/queue/nr_requests 96
    write /sys/block/sdf/queue/nr_requests 96
    write /sys/block/sdg/queue/nr_requests 96

    write /sys/block/mmcblk0/queue/scheduler vkyber
    write /sys/block/mmcblk0/queue/nr_requests 96

    # vivo thermal chenpuzhi add start
    mkdir /dev/thermal
    chown root system /dev/thermal
    copy /proc/cmdline /dev/thermal/thermal_configs
    chmod 0640 /dev/thermal/thermal_configs
    chown root system /dev/thermal/thermal_configs
    write /dev/thermal/thermal_configs 0
    # vivo thermal chenpuzhi add end

service io_enhance /vendor/bin/io_enhance.sh
    disabled
    user root
    group root
    oneshot

on property:sys.boot_completed=1
    start io_enhance
    # vivo yangyang add end

on property:sys.bbklog.dmabuf=1
    exec u:r:dumpstate:s0 -- /system/bin/sh -c "dmabuf_dump > /sdcard/dmabuf_dump.txt"
    setprop sys.bbklog.dmabuf 0

# vchg shixiaosheng add for qbgdump
on property:sys.boot_completed=1
    chmod 0664 /sys/devices/platform/soc/soc:qcom,pmic_glink_log/soc:qcom,pmic_glink_log:qcom,battery_debug/qbg_context
    chown system root /sys/devices/platform/soc/soc:qcom,pmic_glink_log/soc:qcom,pmic_glink_log:qcom,battery_debug/qbg_context
    chmod 0664 /sys/devices/platform/soc/soc:pmic-glink-log/soc:pmic-glink-log:battery-debug/qbg_context
    chown system root /sys/devices/platform/soc/soc:pmic-glink-log/soc:pmic-glink-log:battery-debug/qbg_context

on post-fs
    # vivo longwei add for camera begin
    mkdir /dev/cpuset/camera
    chown camera camera /dev/cpuset/camera
    chown camera root /dev/cpuset/camera/tasks
    chown camera camera /dev/cpuset/camera/cgroup.procs
    chmod 0554 /dev/cpuset/camera
    chmod 0664 /dev/cpuset/camera/tasks
    chmod 0664 /dev/cpuset/camera/cgroup.procs
    write /dev/cpuset/camera/cpus	0-7
    write /dev/cpuset/camera/mems	0

    mkdir /dev/cpuset/camera/cpu0
    chown camera camera /dev/cpuset/camera/cpu0
    chown camera root /dev/cpuset/camera/cpu0/tasks
    chown camera camera /dev/cpuset/camera/cpu0/cgroup.procs
    chmod 0554 /dev/cpuset/camera/cpu0
    chmod 0664 /dev/cpuset/camera/cpu0/tasks
    chmod 0664 /dev/cpuset/camera/cpu0/cgroup.procs
    write /dev/cpuset/camera/cpu0/cpus	0
    write /dev/cpuset/camera/cpu0/mems	0

    mkdir /dev/cpuset/camera/cpu1
    chown camera camera /dev/cpuset/camera/cpu1
    chown camera root /dev/cpuset/camera/cpu1/tasks
    chown camera camera /dev/cpuset/camera/cpu1/cgroup.procs
    chmod 0554 /dev/cpuset/camera/cpu1
    chmod 0664 /dev/cpuset/camera/cpu1/tasks
    chmod 0664 /dev/cpuset/camera/cpu1/cgroup.procs
    write /dev/cpuset/camera/cpu1/cpus	1
    write /dev/cpuset/camera/cpu1/mems	0

    mkdir /dev/cpuset/camera/cpu0-1
    chown camera camera /dev/cpuset/camera/cpu0-1
    chown camera root /dev/cpuset/camera/cpu0-1/tasks
    chown camera camera /dev/cpuset/camera/cpu0-1/cgroup.procs
    chmod 0554 /dev/cpuset/camera/cpu0-1
    chmod 0664 /dev/cpuset/camera/cpu0-1/tasks
    chmod 0664 /dev/cpuset/camera/cpu0-1/cgroup.procs
    write /dev/cpuset/camera/cpu0-1/cpus	0-1
    write /dev/cpuset/camera/cpu0-1/mems	0

    mkdir /dev/cpuset/camera/cpu0-7
    chown camera camera /dev/cpuset/camera/cpu0-7
    chown camera root /dev/cpuset/camera/cpu0-7/tasks
    chown camera camera /dev/cpuset/camera/cpu0-7/cgroup.procs
    chmod 0554 /dev/cpuset/camera/cpu0-7
    chmod 0664 /dev/cpuset/camera/cpu0-7/tasks
    chmod 0664 /dev/cpuset/camera/cpu0-7/cgroup.procs
    write /dev/cpuset/camera/cpu0-7/cpus	0-7
    write /dev/cpuset/camera/cpu0-7/mems	0

    mkdir /dev/cpuset/camera/cpu2-3
    chown camera camera /dev/cpuset/camera/cpu2-3
    chown camera root /dev/cpuset/camera/cpu2-3/tasks
    chown camera camera /dev/cpuset/camera/cpu2-3/cgroup.procs
    chmod 0554 /dev/cpuset/camera/cpu2-3
    chmod 0664 /dev/cpuset/camera/cpu2-3/tasks
    chmod 0664 /dev/cpuset/camera/cpu2-3/cgroup.procs
    write /dev/cpuset/camera/cpu2-3/cpus	2-3
    write /dev/cpuset/camera/cpu2-3/mems	0

    mkdir /dev/cpuset/camera/cpu1-6
    chown camera camera /dev/cpuset/camera/cpu1-6
    chown camera root /dev/cpuset/camera/cpu1-6/tasks
    chown camera camera /dev/cpuset/camera/cpu1-6/cgroup.procs
    chmod 0554 /dev/cpuset/camera/cpu1-6
    chmod 0664 /dev/cpuset/camera/cpu1-6/tasks
    chmod 0664 /dev/cpuset/camera/cpu1-6/cgroup.procs
    write /dev/cpuset/camera/cpu1-6/cpus	1-6
    write /dev/cpuset/camera/cpu1-6/mems	0

    mkdir /dev/cpuset/camera/cpu2-6
    chown camera camera /dev/cpuset/camera/cpu2-6
    chown camera root /dev/cpuset/camera/cpu2-6/tasks
    chown camera camera /dev/cpuset/camera/cpu2-6/cgroup.procs
    chmod 0554 /dev/cpuset/camera/cpu2-6
    chmod 0664 /dev/cpuset/camera/cpu2-6/tasks
    chmod 0664 /dev/cpuset/camera/cpu2-6/cgroup.procs
    write /dev/cpuset/camera/cpu2-6/cpus	2-6
    write /dev/cpuset/camera/cpu2-6/mems	0

    mkdir /dev/cpuset/camera/cpu4-6
    chown camera camera /dev/cpuset/camera/cpu4-6
    chown camera root /dev/cpuset/camera/cpu4-6/tasks
    chown camera camera /dev/cpuset/camera/cpu4-6/cgroup.procs
    chmod 0554 /dev/cpuset/camera/cpu4-6
    chmod 0664 /dev/cpuset/camera/cpu4-6/tasks
    chmod 0664 /dev/cpuset/camera/cpu4-6/cgroup.procs
    write /dev/cpuset/camera/cpu4-6/cpus	4-6
    write /dev/cpuset/camera/cpu4-6/mems	0

    mkdir /dev/cpuset/camera/cpu4-5,7
    chown camera camera /dev/cpuset/camera/cpu4-5,7
    chown camera root /dev/cpuset/camera/cpu4-5,7/tasks
    chown camera camera /dev/cpuset/camera/cpu4-5,7/cgroup.procs
    chmod 0554 /dev/cpuset/camera/cpu4-5,7
    chmod 0664 /dev/cpuset/camera/cpu4-5,7/tasks
    chmod 0664 /dev/cpuset/camera/cpu4-5,7/cgroup.procs
    write /dev/cpuset/camera/cpu4,5,7/cpus	4-5,7
    write /dev/cpuset/camera/cpu4,5,7/mems	0

    mkdir /dev/cpuset/camera/cpu6
    chown camera camera /dev/cpuset/camera/cpu6
    chown camera root /dev/cpuset/camera/cpu6/tasks
    chown camera camera /dev/cpuset/camera/cpu6/cgroup.procs
    chmod 0554 /dev/cpuset/camera/cpu6
    chmod 0664 /dev/cpuset/camera/cpu6/tasks
    chmod 0664 /dev/cpuset/camera/cpu6/cgroup.procs
    write /dev/cpuset/camera/cpu6/cpus	6
    write /dev/cpuset/camera/cpu6/mems	0

    mkdir /dev/cpuset/camera/cpu7
    chown camera camera /dev/cpuset/camera/cpu7
    chown camera root /dev/cpuset/camera/cpu7/tasks
    chown camera camera /dev/cpuset/camera/cpu7/cgroup.procs
    chmod 0554 /dev/cpuset/camera/cpu7
    chmod 0664 /dev/cpuset/camera/cpu7/tasks
    chmod 0664 /dev/cpuset/camera/cpu7/cgroup.procs
    write /dev/cpuset/camera/cpu7/cpus	7
    write /dev/cpuset/camera/cpu7/mems	0
    # vivo longwei add for camera end

    #vivo sensor team chenxiang add for spi_ir begin
    chown system system /dev/kookong
    chmod 0666 /dev/kookong
    #vivo sensor team chenxiang add for spi_ir end

    # vivo zhuhequan add for rms begin
    mkdir /dev/cpuset/l-background
    mkdir /dev/cpuset/h-background
    mkdir /dev/cpuset/l-foreground
    copy /dev/cpuset/cpus /dev/cpuset/l-background/cpus
    copy /dev/cpuset/mems /dev/cpuset/l-background/mems
    copy /dev/cpuset/cpus /dev/cpuset/h-background/cpus
    copy /dev/cpuset/mems /dev/cpuset/h-background/mems
    copy /dev/cpuset/cpus /dev/cpuset/l-foreground/cpus
    copy /dev/cpuset/mems /dev/cpuset/l-foreground/mems

    chown system system /dev/cpuset/l-background
    chown system system /dev/cpuset/h-background
    chown system system /dev/cpuset/l-foreground

    chown system root /dev/cpuset/l-background/tasks
    chown system root /dev/cpuset/h-background/tasks
    chown system root /dev/cpuset/l-foreground/tasks

    chown system system /dev/cpuset/l-background/cpus
    chown system system /dev/cpuset/h-background/cpus
    chown system system /dev/cpuset/l-foreground/cpus
    chown system system /dev/cpuset/foreground/cpus
    chown system system /dev/cpuset/restricted/cpus
    chown system system /dev/cpuset/background/cpus
    chown system system /dev/cpuset/top-app/cpus
    chown system system /dev/cpuset/system-background/cpus

    chown system system /dev/cpuset/l-background/mems
    chown system system /dev/cpuset/h-background/mems
    chown system system /dev/cpuset/l-foreground/mems

    chown system system /dev/cpuset/l-background/rsc_group
    chown system system /dev/cpuset/h-background/rsc_group
    chown system system /dev/cpuset/l-foreground/rsc_group

    chmod 0664 /dev/cpuset/l-background/tasks
    chmod 0664 /dev/cpuset/h-background/tasks
    chmod 0664 /dev/cpuset/l-foreground/tasks

    chmod 0664 /dev/cpuset/l-background/cpus
    chmod 0664 /dev/cpuset/h-background/cpus
    chmod 0664 /dev/cpuset/l-foreground/cpus

    chmod 0664 /dev/cpuset/l-background/mems
    chmod 0664 /dev/cpuset/h-background/mems
    chmod 0664 /dev/cpuset/l-foreground/mems

    chmod 0664 /dev/cpuset/l-background/rsc_group
    chmod 0664 /dev/cpuset/h-background/rsc_group
    chmod 0664 /dev/cpuset/l-foreground/rsc_group

    chmod 0664 /dev/cpuset/l-background/cgroup.procs
    chmod 0664 /dev/cpuset/h-background/cgroup.procs
    chmod 0664 /dev/cpuset/l-foreground/cgroup.procs
    chmod 0664 /dev/cpuset/background/cgroup.procs
    chmod 0664 /dev/cpuset/top-app/cgroup.procs
    chmod 0664 /dev/cpuset/foreground/cgroup.procs
    chmod 0664 /dev/cpuset/system-background/cgroup.procs
    chmod 0664 /dev/cpuset/restricted/cgroup.procs

    chown system system /dev/cpuset/l-background/cgroup.procs
    chown system system /dev/cpuset/h-background/cgroup.procs
    chown system system /dev/cpuset/l-foreground/cgroup.procs
    chown system system /dev/cpuset/background/cgroup.procs
    chown system system /dev/cpuset/top-app/cgroup.procs
    chown system system /dev/cpuset/foreground/cgroup.procs
    chown system system /dev/cpuset/system-background/cgroup.procs
    chown system system /dev/cpuset/restricted/cgroup.procs

    mkdir /dev/cpuctl/l-foreground
    mkdir /dev/cpuctl/h-background
    mkdir /dev/cpuctl/l-background
    mkdir /dev/cpuctl/l-foreground-limit
    mkdir /dev/cpuctl/h-background-limit
    mkdir /dev/cpuctl/background-limit
    mkdir /dev/cpuctl/system-background-limit
    mkdir /dev/cpuctl/l-background-limit

    write /dev/cpuctl/l-foreground-limit/cpu.shares 225
    write /dev/cpuctl/h-background-limit/cpu.shares 169
    write /dev/cpuctl/background-limit/cpu.shares 169
    write /dev/cpuctl/system-background-limit/cpu.shares 169
    write /dev/cpuctl/l-background-limit/cpu.shares 134
    write /dev/cpuctl/top-app/cpu.shares 5120
    write /dev/cpuctl/foreground/cpu.shares 4196

    chmod 0664 /dev/cpuctl/top-app/cgroup.procs
    chmod 0664 /dev/cpuctl/foreground/cgroup.procs
    chmod 0664 /dev/cpuctl/l-foreground/cgroup.procs
    chmod 0664 /dev/cpuctl/h-background/cgroup.procs
    chmod 0664 /dev/cpuctl/background/cgroup.procs
    chmod 0664 /dev/cpuctl/system-background/cgroup.procs
    chmod 0664 /dev/cpuctl/l-background/cgroup.procs
    chmod 0664 /dev/cpuctl/l-foreground-limit/cgroup.procs
    chmod 0664 /dev/cpuctl/h-background-limit/cgroup.procs
    chmod 0664 /dev/cpuctl/background-limit/cgroup.procs
    chmod 0664 /dev/cpuctl/system-background-limit/cgroup.procs
    chmod 0664 /dev/cpuctl/l-background-limit/cgroup.procs

    chown system system /dev/cpuctl/top-app/cgroup.procs
    chown system system /dev/cpuctl/foreground/cgroup.procs
    chown system system /dev/cpuctl/l-foreground/cgroup.procs
    chown system system /dev/cpuctl/h-background/cgroup.procs
    chown system system /dev/cpuctl/background/cgroup.procs
    chown system system /dev/cpuctl/system-background/cgroup.procs
    chown system system /dev/cpuctl/l-background/cgroup.procs
    chown system system /dev/cpuctl/l-foreground-limit/cgroup.procs
    chown system system /dev/cpuctl/h-background-limit/cgroup.procs
    chown system system /dev/cpuctl/background-limit/cgroup.procs
    chown system system /dev/cpuctl/system-background-limit/cgroup.procs
    chown system system /dev/cpuctl/l-background-limit/cgroup.procs

    chmod 0664 /dev/cpuctl/l-foreground/tasks
    chmod 0664 /dev/cpuctl/h-background/tasks
    chmod 0664 /dev/cpuctl/l-background/tasks
    chmod 0664 /dev/cpuctl/l-foreground-limit/tasks
    chmod 0664 /dev/cpuctl/h-background-limit/tasks
    chmod 0664 /dev/cpuctl/background-limit/tasks
    chmod 0664 /dev/cpuctl/system-background-limit/tasks
    chmod 0664 /dev/cpuctl/l-background-limit/tasks

    chown system root /dev/cpuctl/l-foreground/tasks
    chown system root /dev/cpuctl/h-background/tasks
    chown system root /dev/cpuctl/l-background/tasks
    chown system root /dev/cpuctl/l-foreground-limit/tasks
    chown system root /dev/cpuctl/h-background-limit/tasks
    chown system root /dev/cpuctl/background-limit/tasks
    chown system root /dev/cpuctl/system-background-limit/tasks
    chown system root /dev/cpuctl/l-background-limit/tasks

    chown system system /dev/stune/top-app/cgroup.procs
    chown system system /dev/stune/foreground/cgroup.procs
    chown system system /dev/stune/background/cgroup.procs
    chmod 0664 /dev/stune/top-app/cgroup.procs
    chmod 0664 /dev/stune/foreground/cgroup.procs
    chmod 0664 /dev/stune/background/cgroup.procs

    write /dev/cpuset/l-background/rsc_group 3
    write /dev/cpuset/h-background/rsc_group 1
    write /dev/cpuset/l-foreground/rsc_group 0

    mkdir /dev/blkio/bg
    mkdir /dev/blkio/normal
    mkdir /dev/blkio/fg
    mkdir /dev/blkio/top
    chown system system /dev/blkio
    chown system system /dev/blkio/bg
    chown system system /dev/blkio/normal
    chown system system /dev/blkio/fg
    chown system system /dev/blkio/top
    chown system system /dev/blkio/tasks
    chown system system /dev/blkio/bg/tasks
    chown system system /dev/blkio/normal/tasks
    chown system system /dev/blkio/fg/tasks
    chown system system /dev/blkio/top/tasks
    chown system system /dev/blkio/bg/cgroup.procs
    chown system system /dev/blkio/normal/cgroup.procs
    chown system system /dev/blkio/fg/cgroup.procs
    chown system system /dev/blkio/top/cgroup.procs
    chmod 0664 /dev/blkio/tasks
    chmod 0664 /dev/blkio/bg/tasks
    chmod 0664 /dev/blkio/normal/tasks
    chmod 0664 /dev/blkio/fg/tasks
    chmod 0664 /dev/blkio/top/tasks
    chmod 0664 /dev/blkio/bg/cgroup.procs
    chmod 0664 /dev/blkio/normal/cgroup.procs
    chmod 0664 /dev/blkio/fg/cgroup.procs
    chmod 0664 /dev/blkio/top/cgroup.procs
    write /dev/blkio/blkio.weight 300
    write /dev/blkio/bg/blkio.weight 100
    write /dev/blkio/normal/blkio.weight 300
    write /dev/blkio/fg/blkio.weight 400
    write /dev/blkio/top/blkio.weight 1000
    write /dev/blkio/blkio.group_idle 0
    write /dev/blkio/bg/blkio.group_idle 0
    write /dev/blkio/normal/blkio.group_idle 0
    write /dev/blkio/fg/blkio.group_idle 0
    write /dev/blkio/top/blkio.group_idle 0
    write /dev/blkio/bg/blkio.bfq.weight 100
    write /dev/blkio/normal/blkio.bfq.weight 300
    write /dev/blkio/fg/blkio.bfq.weight 400
    write /dev/blkio/top/blkio.bfq.weight 1000

    write /dev/blkio/top/blkio.priority 1
    write /dev/blkio/fg/blkio.priority 2
    write /dev/blkio/normal/blkio.priority 3
    write /dev/blkio/blkio.priority 4
    write /dev/blkio/bg/blkio.priority 5

    write /dev/blkio/top/blkio.vprio 1
    write /dev/blkio/fg/blkio.vprio 2
    write /dev/blkio/normal/blkio.vprio 3
    write /dev/blkio/blkio.vprio 4
    write /dev/blkio/bg/blkio.vprio 5
    # vivo zhuhequan add for rms end

    # vivo zhuzhifeng add for system_exception beigin
    chown system system /dev/system_exception
    chmod 0640 /dev/system_exception
    # vivo zhuzhifeng add for system_exception end

    # vivo zhuzhifeng add for system_exception beigin
    chmod 0666 /dev/special_zygote
    # vivo zhuzhifeng add for system_exception end

    # for net_prio control start by vivo zhangzhangong
    mkdir /dev/net_prio
    mount cgroup none /dev/net_prio net_prio
    mkdir /dev/net_prio/fg

    chown system system /dev/net_prio
    chown system system /dev/net_prio/fg

    chown system system /dev/net_prio/tasks
    chown system system /dev/net_prio/fg/tasks
    chmod 0664 /dev/net_prio/fg/tasks
    chmod 0664 /dev/net_prio/tasks

    chown system system /dev/net_prio/cgroup.procs
    chown system system /dev/net_prio/fg/cgroup.procs
    chmod 0664 /dev/net_prio/fg/cgroup.procs
    chmod 0664 /dev/net_prio/cgroup.procs
    # for net_prio control end by vivo zhangzhangong

    #vivo xushiming add for mobile_log_d read begin
    chown root system /dev/kmsg
    chmod 0664 /dev/kmsg
    #vivo xushiming add for mobile_log_d read end

    # vivo mayi add for dex2oat begin
    mkdir /dev/cpuset/dex2oat
    copy /dev/cpuset/cpus /dev/cpuset/dex2oat/cpus
    copy /dev/cpuset/mems /dev/cpuset/dex2oat/mems
    chown system system /dev/cpuset/dex2oat

    chown system root /dev/cpuset/dex2oat/tasks

    chown system system /dev/cpuset/dex2oat/cpus
    chown system system /dev/cpuset/dex2oat/mems
    chown system system /dev/cpuset/dex2oat/rsc_group

    chmod 0664 /dev/cpuset/dex2oat/tasks
    chmod 0664 /dev/cpuset/dex2oat/cpus
    chmod 0664 /dev/cpuset/dex2oat/mems
    chmod 0664 /dev/cpuset/dex2oat/rsc_group
    chmod 0664 /dev/cpuset/dex2oat/cgroup.procs
    chown system system /dev/cpuset/dex2oat/cgroup.procs

    write /dev/cpuset/dex2oat/cpus 0-7

    mkdir /dev/cpuset/dex2oat/bootcomplete
    copy /dev/cpuset/cpus /dev/cpuset/dex2oat/bootcomplete/cpus
    copy /dev/cpuset/mems /dev/cpuset/dex2oat/bootcomplete/mems
    chown system system /dev/cpuset/dex2oat/bootcomplete

    chown system root /dev/cpuset/dex2oat/bootcomplete/tasks

    chown system system /dev/cpuset/dex2oat/bootcomplete/cpus
    chown system system /dev/cpuset/dex2oat/bootcomplete/mems
    chown system system /dev/cpuset/dex2oat/bootcomplete/rsc_group

    chmod 0664 /dev/cpuset/dex2oat/bootcomplete/tasks
    chmod 0664 /dev/cpuset/dex2oat/bootcomplete/cpus
    chmod 0664 /dev/cpuset/dex2oat/bootcomplete/mems
    chmod 0664 /dev/cpuset/dex2oat/bootcomplete/rsc_group
    chmod 0664 /dev/cpuset/dex2oat/bootcomplete/cgroup.procs
    chown system system /dev/cpuset/dex2oat/bootcomplete/cgroup.procs

    write /dev/cpuset/dex2oat/bootcomplete/cpus 0-7

    mkdir /dev/cpuset/dex2oat/background
    copy /dev/cpuset/cpus /dev/cpuset/dex2oat/background/cpus
    copy /dev/cpuset/mems /dev/cpuset/dex2oat/background/mems
    chown system system /dev/cpuset/dex2oat/background

    chown system root /dev/cpuset/dex2oat/background/tasks

    chown system system /dev/cpuset/dex2oat/background/cpus
    chown system system /dev/cpuset/dex2oat/background/mems
    chown system system /dev/cpuset/dex2oat/background/rsc_group

    chmod 0664 /dev/cpuset/dex2oat/background/tasks
    chmod 0664 /dev/cpuset/dex2oat/background/cpus
    chmod 0664 /dev/cpuset/dex2oat/background/mems
    chmod 0664 /dev/cpuset/dex2oat/background/rsc_group
    chmod 0664 /dev/cpuset/dex2oat/background/cgroup.procs
    chown system system /dev/cpuset/dex2oat/background/cgroup.procs

