# vivo wuyuanhan add for boottime begin
service vivo_bsp_boottime_enablelog /system/bin/vivo_boottime.sh enablelog
    class main
    user root
    group root system 
    disabled
    oneshot

service vivo_bsp_boottime_disablelog /system/bin/vivo_boottime.sh disablelog
    class main
    user root
    group root system
    disabled
    oneshot   
    
## vivo wuyuanhan add for boottime begin
service vivo_bsp_boottime /system/bin/vivo_boottime.sh
    class main
    user root
    group root system
    disabled
    oneshot    

service vivo_bsp_boottime_dmesglog /system/bin/vivo_boottime.sh dmesg_log
    class main
    user root
    group root system
    disabled
    oneshot   

# for bbklog
on property:sys.boottime.log=0
    start vivo_bsp_boottime_disablelog

on property:sys.boottime.log=1
    start vivo_bsp_boottime_enablelog

on property:sys.boot_completed=1
    start vivo_bsp_boottime	

on post-fs-data
    mkdir /data/boottime  0777 system system encryption=Attempt
    chmod 0777 /data/boottime
    start vivo_bsp_boottime_dmesglog
