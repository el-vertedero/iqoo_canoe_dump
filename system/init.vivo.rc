# vivo dengzhiyong [B210514-1599] add
on post-fs-data
    setprop sys.yzfsj.symlink 1

on property:sys.yzfsj.symlink=1 && property:ro.build.version.group=V2.0
    rm data/yzfswj/another
    symlink /data/preload/config /data/yzfswj/another
    chmod 0771 /data/yzfswj
# vivo dengzhiyong [B210514-1599] add

# Zhangjing MiniDump add
on property:persist.vivo.networkstate.minidump=1
   setprop persist.vendor.ril.crash_handling_mode 1
   setprop persist.vivo.networkstate.minidump 0

on property:persist.vivo.networkstate.minidump=2
   setprop persist.vendor.ril.crash_handling_mode 2
   setprop persist.vivo.networkstate.minidump 0
# end

# vivo wuzengshun add to cryptfs uses the cache or logdata partition
on post-fs-data && property:ro.virtual_ab.enabled=true
    mkdir /data/vivo-common/temps_app 0777 system system
    mkdir /data/vivo-common/vota 0777 root system
    mkdir /data/vivo-common/vota/device 0777 root system
    mkdir /data/vivo-common/vota/update_data 0777 root system
    mkdir /data/vivo-common/dyn 0771 system system

on post-fs && property:ro.virtual_ab.enabled=true
    mkdir /logdata/recovery 0770 system cache
    chown system cache /logdata
    chmod 0770 /logdata
    restorecon_recursive /logdata
    mkdir /logdata/cryptfs 0770 system cache
    mkdir /logdata/security_bsp 0770 system cache
    mkdir /logdata/recovery 0770 system cache
    mkdir /logdata/recovery/update_engine_log 0770 system cache
    mkdir /logdata/recovery/update_engine_log_err 0770 system cache
    mkdir /metadata/vota 0700 root system
    mkdir /metadata/vota/snapshots 0700 root system
    mkdir /metadata/vota/misc 0700 root system
    mkdir /metadata/vota/misc/message 0700 root system
    mkdir /metadata/vota/transfer 0700 root system
    # vivo lizhijiao add for engineermode in v-ab
    mkdir /logdata/recovery/engineer 0774
    mkdir /logdata/recovery/engineer/recovery 0774
    chown system cache /logdata/recovery/engineer
    chown system cache /logdata/recovery/engineer/recovery
    restorecon /logdata/recovery/engineer
    chmod /cache/recovery 0774
    chown system system /cache/recovery
    restorecon /cache/recovery

on post-fs && property:ro.virtual_ab.enabled=""
    mkdir /cache/recovery 0770 system cache
    mkdir /cache/cryptfs 0770 system cache
    mkdir /cache/security_bsp 0770 system cache
    # miaoqiang add for create a file in /cache/recovery, case system_app will rm /cache/recovery
    write /cache/recovery/last_test 1

#vivo chenxiaoju add for videodebug begin
on boot
    chmod 0777 /sys/module/msm_video/parameters/msm_vidc_debug
    chmod 0777 /sys/module/mtk_vcodec_dec_v2/parameters/mtk_v4l2_dbg_level
    chmod 0777 /sys/module/mtk_vcodec_dec_v2/parameters/mtk_vcodec_dbg
    chmod 0777 /sys/module/mtk_vcodec_dec_v2/parameters/mtk_vdec_vcp_log
    chmod 0777 /sys/module/mtk_vcodec_dec_v2/parameters/mtk_vcodec_perf
    chmod 0777 /sys/module/mtk_vcodec_dec_v1/parameters/mtk_v4l2_dbg_level
    chmod 0777 /sys/module/mtk_vcodec_dec_v1/parameters/mtk_vcodec_dbg
    chmod 0777 /sys/module/mtk_vcodec_dec_v1/parameters/mtk_vdec_vcp_log
    chmod 0777 /sys/module/mtk_vcodec_dec_v1/parameters/mtk_vcodec_perf
    chmod 0777 /sys/module/mtk_vcodec_dec/parameters/mtk_v4l2_dbg_level
    chmod 0777 /sys/module/mtk_vcodec_dec/parameters/mtk_vcodec_dbg
    chmod 0777 /sys/module/mtk_vcu/parameters/test_info
#vivo chenxiaoju add for videodebug end

# vivo linpeilin add for vgc update in virtual_ab begin
on post-fs-data && property:ro.virtual_ab.enabled=true && property:sys.vgc_ex.mount=1
    mount ext4 loop@/data/vivo-common/vota/update_data/vgc_ex${ro.boot.slot_suffix}.img /vendor/vgc ro relatime discard
# vivo linpeilin add for vgc update in virtual_ab end

# vivo linpeilin add for restore remounted device begin
on property:ro.virtual_ab.enabled=true && property:sys.restore_remount=1
    rm /metadata/gsi/remount/lp_metadata
    rm /metadata/gsi/remount/scratch.status
    setprop sys.restore_remount 0
# vivo linpeilin add for restore remounted device end

# vivo linpeilin add for a/b ota begin
on property:sys.vivo.system_update=*
    write /sys/class/cms_class/system_update ${sys.vivo.system_update}
# vivo linpeilin add for a/b ota end

# vivo wuzengshun add for custom repair begin
on property:ro.crypto.type=file && property:sys.fbe_copy=1
    inithook customrepair

on property:ro.crypto.type=block && property:sys.boot_completed=1 && property:vold.encrypt_progress=100
    inithook customrepair

on property:ro.vivo.oem.all.in.one.support=*
    setprop ro.vendor.defend.oem.all.in.one.support ${ro.vivo.oem.all.in.one.support}

on property:ro.vivo.oem.all.in.one.name=*
    setprop ro.vendor.defend.oem.all.in.one.name ${ro.vivo.oem.all.in.one.name}

copy /system/etc/oem-all-in-one.txt /data/vendor/security_bsp/oem-all-in-one.txt
# vivo wuzengshun add for custom repair end

# vivo linpeilin add for restart update_engine begin
on property:ro.virtual_ab.enabled=true && property:sys.vivo.restart.update_engine=1
    restart update_engine
# vivo linpeilin add for restart update_engine end

# vivo zhuangyan add for dota_info begin
on property:sys.user.0.ce_available=true
    exec - root -- /system/vendor/bin/vota_client dota_info
    setprop sys.vivo.dota_code ${persist.vendor.vivo.dota_code}
    setprop sys.vivo.dota_info0 ${persist.vendor.vivo.dota_info0}
    setprop sys.vivo.dota_info1 ${persist.vendor.vivo.dota_info1}
    setprop sys.vivo.dota_info2 ${persist.vendor.vivo.dota_info2}
    setprop sys.vivo.dota_info3 ${persist.vendor.vivo.dota_info3}
    setprop sys.vivo.dota_info4 ${persist.vendor.vivo.dota_info4}
    setprop sys.vivo.dota_info5 ${persist.vendor.vivo.dota_info5}
# vivo zhuangyan add for dota_info end

## vivo corebsp add for debug begin
service vivo_bsplog /system/bin/vivo_bsplog
    user root
    group root system
    disabled
    oneshot

on init && property:ro.boot.bsplog.dump=1
    start vivo_bsplog

service vivo_console /system/bin/sh
    class core
    console
    disabled
    user root
    group shell log readproc
    seclabel u:r:shell:s0
    setenv HOSTNAME console

on init && property:ro.boot.bsplog.console=1
    stop console
    start vivo_console
	
on property:ro.boot.bsplog.console=1
   write /dev/kmsg "ro.boot.bsplog.console stage config"
   write /proc/sys/kernel/printk "1 1 2 2"

on init && property:ro.boot.bsplog.console=1
   write /dev/kmsg "init stage config"
   write /proc/sys/kernel/printk "1 1 2 2"

on early-init && property:ro.boot.bsplog.console=1
   write /dev/kmsg "early-init stage config"
   write /proc/sys/kernel/printk "1 1 2 2"

on early-init &&  property:ro.vivo.product.model=PD2452D
   setprop ro.vivo.support_monster_plus false
   setprop ro.vivo.support_monster_plus_combine false
on early-init &&  property:ro.vivo.product.model=PD2452
   setprop ro.vivo.support_monster_plus true
   setprop ro.vivo.support_monster_plus_combine true

on post-fs && property:ro.boot.bsplog.console=1
   write /dev/kmsg "post-fs stage config"
   write /proc/sys/kernel/printk "1 1 2 2"

on post-fs-data && property:ro.boot.bsplog.console=1
   write /dev/kmsg "post-fs-data stage config"
   write /proc/sys/kernel/printk "1 1 2 2"

on boot && property:ro.boot.bsplog.console=1
   write /dev/kmsg "boot stage config"
   write /proc/sys/kernel/printk "1 1 2 2"

on property:sys.boot_completed=1 && property:ro.boot.bsplog.console=1
   write /dev/kmsg "sys.boot_completed stage config"
   write /proc/sys/kernel/printk "1 1 2 2"

on property:vendor.post_boot.parsed=1 && property:ro.boot.bsplog.console=1
   write /dev/kmsg "vendor.post_boot.parsed stage config"
   write /proc/sys/kernel/printk "1 1 2 2"

## vivo corebsp add for debug end

# vivo 11070486 add for logsystem start
on property:persist.vivo.logsystem.cpke=1
    exec u:r:shell:s0 system system debuggerd -- /system/bin/cp -r --preserve=timestamps /data/vendor/aee_exp /data/logData
    setprop persist.vivo.logsystem.cpke 0

on property:persist.vivo.logsystem.cpke=2
    exec u:r:shell:s0 system system debuggerd -- /system/bin/chmod 777 -R /data/logData/aee_exp/
    setprop persist.vivo.logsystem.cpke 0
# vivo 11070486 add for logsystem end

