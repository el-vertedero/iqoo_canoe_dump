# add for fg_common system_time in android14
on property:sys.vivo.bootcompleted=1 && property:persist.sys.timezone=*
    write /sys/class/power_supply/fg_common/sys_tz ${persist.sys.timezone}

# add for fg_common precompile_apk_soc_enable
on property:persist.sys.vivo.otadexopt=*
	write /sys/class/power_supply/fg_common/otadexopt ${persist.sys.vivo.otadexopt}

on property:ro.device.demo=1
    write /sys/class/power_supply/battery/keep_chg_soc 60
    write /sys/class/power_supply/battery/exhibition_mode 1
    write /sys/class/power_supply/cms/exhibition_mode 1
    write /sys/class/cms_class/keep_chg_soc 60
    write /sys/class/cms_class/exhibition_mode 1

on property:sys.demo.no_charge_protect=1
    write /sys/class/power_supply/battery/keep_chg_soc 100
    write /sys/class/power_supply/battery/exhibition_mode 0
    write /sys/class/power_supply/cms/exhibition_mode 0
    write /sys/class/cms_class/keep_chg_soc 100
    write /sys/class/cms_class/exhibition_mode 0

on property:persist.sys.mtbf.test=1
    write /sys/kernel/debug/cms/debug "LG4"
    write /sys/class/cms_debug/debug "LG4"

on property:persist.vivo.calling_state=*
    write /sys/class/cms_class/calling_state ${persist.vivo.calling_state}
    write /sys/class/power_supply/cms/calling_state ${persist.vivo.calling_state}

on property:persist.vivo.weixin_calling_state=*
    write /sys/class/cms_class/weixin_calling_state ${persist.vivo.weixin_calling_state}
    write /sys/class/power_supply/cms/weixin_calling_state ${persist.vivo.weixin_calling_state}

on property:sys.vivo.pkg_state=*
    write /sys/class/cms_class/pkg_state ${sys.vivo.pkg_state}
    write /sys/class/power_supply/cms/pkg_state ${sys.vivo.pkg_state}

on property:sys.fuelsummary.user_custom=*
    write /sys/class/fuelsummary/user_custom ${sys.fuelsummary.user_custom}

on property:vendor.fuelsummary.user_custom=*
    write /sys/class/fuelsummary/user_custom ${vendor.fuelsummary.user_custom}

on property:persist.vivo.wpc_tx=*
    write /sys/class/cms_class/wpc_tx ${persist.vivo.wpc_tx}

on property:sys.vivo.enable_reverse_wireless_charge=*
    write /sys/class/cms_class/wpc_tx ${sys.vivo.enable_reverse_wireless_charge}

on property:sys.vivo.gsm=*
    write /sys/class/cms_class/gsm ${sys.vivo.gsm}

on property:sys.pan.bat_level=*
    write /sys/class/cms_class/panlevel ${sys.pan.bat_level}

on property:sys.pad.tx_en=*
    write /sys/class/cms_class/wls_hall ${sys.pad.tx_en}

on property:persist.vivo.otg_silicon_batt_low_thr=*
    write /sys/class/cms_class/otg_silicon_batt_low_thr ${persist.vivo.otg_silicon_batt_low_thr}

on property:sys.battery.loss_event_update=*
    exec u:r:shell:s0 system system -- /system/bin/cp -rf /mnt/vendor/persist/charger/loss_table.txt /data/vlog/1501/
    exec u:r:shell:s0 system system -- /system/bin/cp -rf /mnt/vendor/persist/charger/static_table_week.txt /data/vlog/1501/
    exec u:r:shell:s0 system system -- /system/bin/cp -rf /mnt/vendor/persist/charger/dynamic_table_week.txt /data/vlog/1501/
    exec u:r:shell:s0 system system -- /system/bin/cp -rf /mnt/vendor/persist/charger/static_table_week_last.txt /data/vlog/1501/
    exec u:r:shell:s0 system system -- /system/bin/cp -rf /mnt/vendor/persist/charger/dynamic_table_week_last.txt /data/vlog/1501/
    exec u:r:shell:s0 system system -- /system/bin/cp -rf /mnt/vendor/persist/charger/loss_table_before.txt /data/vlog/1501/
    exec u:r:shell:s0 system system -- /system/bin/cp -rf /mnt/vendor/persist/charger/soh_loss_event_reason.txt /data/vlog/1501/
    exec u:r:shell:s0 system system -- /system/bin/sh -c "/system/bin/ls -lZ /mnt/vendor/persist/charger > /data/vlog/1501/loss_dir_list.txt"
    restorecon --force --recursive /mnt/vendor/persist/charger

# vivo fuxi add for demo phone suppress charging end

