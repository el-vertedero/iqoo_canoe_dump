# vivo zhangjianqin add, if in stability test, corefile limit for open coredump.
on property:persist.vivo.stability.debug=1 && property:persist.debug.trace= && property:persist.vendor.aeev.core.dump=
    mkdir /data/core 0777 root root encryption=Attempt
    chown system system /data/core
    write /proc/sys/fs/suid_dumpable 1
    write /proc/sys/kernel/core_pattern "/data/core/%E.%e"
    #write /proc/sys/kernel/core_pattern "|/system/bin/vivo_coredump %E %p %e"

