<?xml version="1.0" encoding="utf-8"?>
<fontSymbolAnimation>
    <animInfo animUnicode="0xE0176" />

    <animationList>
        <symbolAnimation layerCnt="7">
            <originStatus alpha="1.0" glyphAnimProgress="100" >
                <layer index="1" alpha="0.01" />
            </originStatus>
            <parallelGroup >

                <serialGroup>
                    <animationItem animationType="glyphAnimProgress" duration="0" to="150" />
                    <animationItem animationType="glyphAnimProgress" duration="250" to="200" interpolator="custom(0.25, 0.10, 0.25, 1.00)" />
                </serialGroup>

                <!-- 斜杠 -->
                <animationItem animationType="dynamicColor" duration="250" to="0xE6E6E6" layersIndex="5" interpolator="custom(0.25, 0.09, 0.25, 1.00)"  />
                <serialGroup>
                    <animationItem animationType="delay" duration="167" />
                    <animationItem animationType="alpha" duration="83" to="0.01" layersIndex="5"  interpolator="custom(0.25, 0.10, 0.25, 1.00)" />
                    <!--  扔掉斜杠  -->
                    <animationItem animationType="translateX" duration="0" to="-200" layersIndex="5" />
                </serialGroup>

                <!-- 斜杠挡板 -->
                <animationItem animationType="dynamicColor" duration="250" to="0xFFFFFF" layersIndex="4" interpolator="custom(0.17, 0.10, 0.83, 1.00)"  />
                <animationItem animationType="dynamicAlpha" duration="250" to="0.15" layersIndex="4"  interpolator="custom(0.17, 0.10, 0.83, 1.00))" />
                <serialGroup>
                    <animationItem animationType="delay" duration="250" />
                    <!--  扔掉斜杠挡板  -->
                    <animationItem animationType="translateX" duration="0" to="-200" layersIndex="4,3" />
                </serialGroup>

                <!-- 喇叭 -->
                <animationItem animationType="dynamicColor" duration="250" to="0xE6E6E6" layersIndex="2" interpolator="custom(0.17, 0.00, 0.25, 1.00)"  />

                <!-- 声波 -->
                <animationItem animationType="alpha" duration="250" to="1" layersIndex="1"  interpolator="custom(0.25, 0.10, 0.25, 1.00)" />

                <!-- 背景图 -->
                <animationItem animationType="dynamicColor" duration="250" to="0xFFFFFF" layersIndex="0" interpolator="custom(0.17, 0.10, 0.83, 1.00)"  />
                <animationItem animationType="dynamicAlpha" duration="250" to="0.15" layersIndex="0"  interpolator="custom(0.17, 0.10, 0.83, 1.00)" />

            </parallelGroup>
        </symbolAnimation>
    </animationList>

</fontSymbolAnimation>
