<?xml version="1.0" encoding="utf-8"?>
<fontSymbolAnimation>
    <animInfo animUnicode="0x100012" />


    <animationList>

        <symbolAnimation layerCnt="4" >

            <drawAnimDataList>
                <!-- layers 指定当前draw对应的层id. 只能是一个int  -->
                <drawAnimData layers="0" endCapType="0">
                    <!-- acrossBase 记录与前一点之间的连接是否跨过了 起始点, 连接顺序如下-->
                    <!-- A1 << A2  -->
                    <!-- v     v   -->
                    <!-- B1    B2  -->
                    <!-- v     v   -->
                    <!-- Z1 >> Z2  -->
                    <!-- 因Z2与两个点连接, 所以其中Z1->Z2有无跨过起始点用 tailAcrossBasePoint 表示 -->
                    <!-- type "0"表示默认. "1"表示角点  -->
                    <guidePointPair type="0" contourIndex0="0" pointIndex0="0" acrossBasePoint0="0" contourIndex1="0" pointIndex1="0" acrossBasePoint1="0" tailAcrossBasePoint="0" />

                </drawAnimData>
                <drawAnimData layers="2" endCapType="1">
                    <guidePointPair type="0" contourIndex0="1" pointIndex0="1" contourIndex1="1" pointIndex1="2" />
                </drawAnimData>
            </drawAnimDataList>


            <originStatus  glyphAnimProgress="100" color="0xFFFFFF" drawHead="0.2" drawTail="0">
                <layer index="0" alpha="1" drawHead="0.2" drawTail="0"/>
                <layer index="1" alpha="0"/>
                <layer index="2" alpha="1"/>
                <layer index="3" alpha="0"/>
            </originStatus>
            <parallelGroup interpolator="linear">
                <animationItem animationType="glyphAnimProgress" duration="367" to="650"/>
                <animationItem animationType="drawHead" layersIndex="0" duration="367" to="0.5"/>
                <animationItem animationType="drawTail" layersIndex="0" duration="367" to="0.5"/>
                <serialGroup>
                    <animationItem animationType="alpha" duration="150" to="0" layersIndex="0,2"/>
                    <animationItem animationType="alpha" duration="150" to="1" layersIndex="1,3"/>
                </serialGroup>
            </parallelGroup>
        </symbolAnimation>

    </animationList>

</fontSymbolAnimation>
