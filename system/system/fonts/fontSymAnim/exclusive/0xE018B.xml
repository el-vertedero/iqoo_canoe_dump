<?xml version="1.0" encoding="utf-8"?>
<fontSymbolAnimation>
    <animInfo animUnicode="0xE018B" />
    <animationList>
        <symbolAnimation layerCnt="2" scalePivotLayerIndex="3" rotPivotLayerIndex="3" >
            <originStatus alpha="1" >
            </originStatus>
            <parallelGroup>

                <!-- 外框 -->
                <serialGroup>
                    <animationItem animationType="scale" duration="133" to="0"  layersIndex="0" interpolator="custom(0.42, 0.00, 0.67, 1.00)" />
                    <animationItem animationType="scale" duration="250" to="1.11"  layersIndex="0" interpolator="custom(0.33, 0.00, 0.30, 1.00)" />
                    <animationItem animationType="scale" duration="250" to="1"  layersIndex="0" interpolator="custom(0.10, 0.00, 0.30, 1.00)" />
                </serialGroup>

                <serialGroup>
                    <!-- 初始状态为 0.45 -->
                    <animationItem animationType="alpha" duration="133" to="0"  layersIndex="0,1" interpolator="custom(0.33, 0.00, 0.67, 1.00)" />
                    <animationItem animationType="alpha" duration="150" to="1"  layersIndex="0,1" interpolator="custom(0.33, 0.00, 0.67, 1.00)" />
                </serialGroup>

                <serialGroup>
                    <animationItem animationType="delay" duration="133" />
                    <animationItem animationType="dynamicColor" duration="17" to="0xFF852E"  layersIndex="0" />
                </serialGroup>


                <!-- 星星 -->
                <serialGroup>
                    <!-- 叠加背景缩放值, 使用背景缩放曲线  -->
                    <animationItem animationType="scale" duration="133" to="0.001"  layersIndex="1" interpolator="custom(0.42, 0.00, 0.67, 1.00)" />
<!--                    <animationItem animationType="scale" duration="250" to="1.332"  layersIndex="1" interpolator="custom(0.15, 0.18, 0.30, 1.00)" />-->
                    <animationItem animationType="scale" duration="250" to="1.332"  layersIndex="1" interpolator="custom(0.33, 0.00, 0.30, 1.00)" />
                    <animationItem animationType="scale" duration="250" to="1"  layersIndex="1" interpolator="custom(0.10, 0.00, 0.30, 1.00)" />
                </serialGroup>

                <serialGroup>
                    <animationItem animationType="delay" duration="117" />
                    <animationItem animationType="rotationZ" duration="17" to="-120"  layersIndex="1" interpolator="custom(0.17, 0.17, 0.00, 1.00)"  />
                    <animationItem animationType="rotationZ" duration="250" to="45"  layersIndex="1" interpolator="custom(0.15, 0.15, 0.30, 1.00)" />
                    <animationItem animationType="rotationZ" duration="250" to="0"  layersIndex="1" interpolator="custom(0.10, 0.00, 0.30, 1.00)" />
                </serialGroup>

            </parallelGroup>
        </symbolAnimation>
    </animationList>
</fontSymbolAnimation>
