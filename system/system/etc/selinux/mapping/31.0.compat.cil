;; complement CIL file for compatibility between ToT policy and 31.0 vendors.
;; will be compiled along with other normal policy files, on 31.0 vendors.
;;

;; New system images do not allow open() to work on ashmem for all domains,
;; so add it for compatibility with older vendor images.
(allow domain ashmem_libcutils_device (chr_file (open)))

(type vendor_qvr_hidraw_device)
(typeattributeset dev_type (vendor_qvr_hidraw_device))

(allow system_server vendor_qvr_hidraw_device (dir (open getattr read search ioctl lock watch watch_reads)))
(allow system_server vendor_qvr_hidraw_device (chr_file (getattr open read ioctl lock map watch watch_reads append write)))
