    chown system /sys/touchscreen/log_switch
    chown system /sys/touchscreen/suspend_cmd
    chown system /sys/touchscreen/fw_version
    chown system /sys/touchscreen/sensor_baseline
    chown system /sys/touchscreen/ts_ipod_flag
    chown system /sys/touchscreen/imei_write_support
    chmod system /sys/touchscreen/touch_ic_mode
    chmod system /sys/touchscreen/high_scan_rate_support
    
    chmod 0644 /sys/touchscreen/app_name
    chmod 0644 /sys/touchscreen/at_sensor_test
    chmod 0644 /sys/touchscreen/dclick_lcd_state
    chmod 0644 /sys/touchscreen/dclick_proximity_switch
