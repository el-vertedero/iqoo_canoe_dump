    # Start standard binderized HAL daemons
    class_start hal

    class_start core

on boot && property:ro.debuggable=1
    write /dev/sys/fs/by-name/userdata/iostat_period_ms 1000
    write /dev/sys/fs/by-name/userdata/iostat_enable 1

on nonencrypted
    class_start main
    class_start late_start

on property:sys.init_log_level=*
    loglevel ${sys.init_log_level}

############################################################## VIVO_CHG add END
on property:sys.vivo.bootcompleted=1
    chown system system /sys/class/cms_class/keep_soc
    chmod 0664 /sys/class/cms_class/keep_soc
    chown system system /sys/class/cms_class/scene_disable
    chmod 0666 /sys/class/cms_class/scene_disable
    chown system system /sys/class/cms_class/scene_level
    chmod 0666 /sys/class/cms_class/scene_level

    chown system system /sys/class/cms_class/last_mode_notify_flag
    chmod 0664 /sys/class/cms_class/last_mode_notify_flag

    chown system system /sys/class/cms_class/os_version
    chmod 0664 /sys/class/cms_class/os_version
    chown system system /sys/class/cms_class/fist_os_version
    chmod 0664 /sys/class/cms_class/fist_os_version

    write /sys/class/cms_class/os_version ${ro.vivo.os.version}
    write /sys/class/cms_class/fist_os_version ${ro.vivo.fist.os.version}
    write /sys/class/cms_class/switch_state ${persist.vivo.enable_equalizing_charge}
    write /sys/class/cms_class/switch_state ${persist.vivo.enable_equalizing_charge_from_keyguard}
    chown system system /sys/class/cms_class/soh_loss_table
    chmod 0666 /sys/class/cms_class/soh_loss_table
    chown system system /sys/class/cms_class/sys_tz
    chmod 0664 /sys/class/cms_class/sys_tz
    copy /dev/cpuset/background/cpus /dev/cpuset/heatlimit/cpus
    copy /dev/cpuset/background/mems /dev/cpuset/heatlimit/mems
    chown system system /sys/class/cms_class/predict_chg_time_data
    chmod 0666 /sys/class/cms_class/predict_chg_time_data
    chown system system /sys/class/cms_class/sometime_keep_soc
    chmod 0666 /sys/class/cms_class/sometime_keep_soc
    chown system system /sys/class/cms_class/sometime_delta_cycle_n
    chmod 0666 /sys/class/cms_class/sometime_delta_cycle_n
    chown system system /sys/class/cms_class/sometime_plan
    chmod 0666 /sys/class/cms_class/sometime_plan
    chown system system /sys/class/cms_class/loss_condition_sum_table
    chmod 0666 /sys/class/cms_class/loss_condition_sum_table
    chown system system /sys/class/cms_class/soh_life_loss
    chmod 0666 /sys/class/cms_class/soh_life_loss
	chown system system /sys/class/cms_class/soh_loss_event_info
    chmod 0666 /sys/class/cms_class/soh_loss_event_info
    chown system system /sys/class/cms_class/camera_open_state
    chmod 0664 /sys/class/cms_class/camera_open_state
    chown system system /sys/class/cms_class/magnetic_hall_mode
    chmod 0664 /sys/class/cms_class/magnetic_hall_mode

# add for fg_common system_time in android14
on property:sys.vivo.bootcompleted=1 && property:persist.sys.timezone=*
    write /sys/class/power_supply/fg_common/sys_tz ${persist.sys.timezone}
    write /sys/class/cms_class/sys_tz ${persist.sys.timezone}

# PD2283 is special
on property:ro.vivo.product.model=PD2283
	setprop persist.vivo.battery_health_support 2

on property:ro.vivo.product.model=PD2283F_EX
	setprop persist.vivo.battery_health_support 0

on property:ro.vivo.product.model=PD2364
	setprop persist.vivo.last_mode_support 0

on property:ro.vivo.product.model=PD2429
	setprop persist.vivo.ui_reverse_chg 0

on property:persist.vivo.enable_equalizing_charge=*
	write /sys/class/cms_class/switch_state ${persist.vivo.enable_equalizing_charge}
	write /sys/class/power_supply/cms/switch_state ${persist.vivo.enable_equalizing_charge}

on property:persist.vivo.enable_equalizing_charge_from_keyguard=*
	write /sys/class/cms_class/switch_state ${persist.vivo.enable_equalizing_charge_from_keyguard}
	write /sys/class/power_supply/cms/switch_state ${persist.vivo.enable_equalizing_charge_from_keyguard}

on property:persist.vivo.calling_state=*
	write /sys/class/cms_class/calling_state ${persist.vivo.calling_state}
	write /sys/class/power_supply/cms/calling_state ${persist.vivo.calling_state}

on property:persist.vendor.camera.camera4k_state=*
	write /sys/class/cms_class/camera4k_state ${persist.vendor.camera.camera4k_state}
	write /sys/class/power_supply/cms/camera4k_state ${persist.vendor.camera.camera4k_state}

on property:persist.vendor.camera.charge.close=*
	write /sys/class/cms_class/camera_charge_close ${persist.vendor.camera.charge.close}
	write /sys/class/power_supply/mcu/camera_charge_close ${persist.vendor.camera.charge.close}

on property:persist.vivo.weixin_calling_state=*
	write /sys/class/cms_class/weixin_calling_state ${persist.vivo.weixin_calling_state}
	write /sys/class/power_supply/cms/weixin_calling_state ${persist.vivo.weixin_calling_state}

on property:ro.vivo.os.version=*
	write /sys/class/cms_class/os_version ${ro.vivo.os.version}

on property:ro.vivo.fist.os.version=*
	write /sys/class/cms_class/fist_os_version ${ro.vivo.fist.os.version}

on property:persist.vivo.last_mode_notify_flag=*
	write /sys/class/cms_class/last_mode_notify_flag ${persist.vivo.last_mode_notify_flag}

# vivo Wireless RX debug FW update info.
on property:persist.debug.wls_rx_fw_version=*
	write /sys/class/wls_class/wls_rx_fw_version ${persist.debug.wls_rx_fw_version}

on property:persist.debug.wls_rx_fw_crc=*
	write /sys/class/wls_class/wls_rx_fw_crc ${persist.debug.wls_rx_fw_crc}

on property:persist.debug.wireless_QI_authentication=*
	write /sys/class/wls_class/wireless_QI_authentication ${persist.debug.wireless_QI_authentication}

on property:sys.vivo.carlife_state=*
	write /sys/class/cms_class/carlife_state ${sys.vivo.carlife_state}
	write /sys/class/power_supply/cms/carlife_state ${sys.vivo.carlife_state}

on property:sys.vivo.phone_holster_state=*
	write /sys/class/cms_class/phone_holster_state ${sys.vivo.phone_holster_state}
	write /sys/class/power_supply/cms/phone_holster_state ${sys.vivo.phone_holster_state}

on property:sys.vivo.pkg_state=*
	write /sys/class/cms_class/pkg_state ${sys.vivo.pkg_state}
	write /sys/class/power_supply/cms/pkg_state ${sys.vivo.pkg_state}

on property:vendor.vivo.audio.is_handset=*
	write /sys/class/cms_class/is_handset ${vendor.vivo.audio.is_handset}

on property:persist.vivo.camera_state=*
	write /sys/class/cms_class/camera_state ${persist.vivo.camera_state}
	write /sys/class/power_supply/cms/camera_state ${persist.vivo.camera_state}

on property:sys.vivo.gsm_lock_state=*
	write /sys/class/cms_class/gsm_lock_state ${sys.vivo.gsm_lock_state}

on property:persist.vivo.intell_scene=*
	write /sys/class/cms_class/scene_recognition ${persist.vivo.intell_scene}
	write /sys/class/power_supply/cms/scene_recognition ${persist.vivo.intell_scene}

on property:persist.sys.mtbf.test=1
	write /sys/class/cms_debug/debug "LG4"
	write /sys/kernel/debug/cms/debug "LG4"

on property:sys.vivo.disable_charge=*
	write /sys/class/cms_class/disable_charge ${sys.vivo.disable_charge}
	write /sys/class/power_supply/cms/disable_charge ${sys.vivo.disable_charge}
on property:sys.vivo.enable_reverse_wireless_charge=*
	write /sys/class/cms_class/wpc_tx ${sys.vivo.enable_reverse_wireless_charge}
############################################################## VIVO_CHG add END

on charger
    #### VIVO_CHG add more HAL log to /dev/kmsg:  below action seem no useless;  please try "fastboot oem bspdebug bspdebug=1 --> cmdline:printk.devkmsg=on "
    #write /proc/sys/kernel/printk_ratelimit 5
    #write /proc/sys/kernel/printk_ratelimit_burst 10000
    #write /proc/sys/kernel/printk "8 8 8 8"
    #write /proc/sys/kernel/printk_devkmsg "on"

    # VIVO_CHG hvdcp_opti disable hvdcp param
    setprop persist.vendor.hvdcp_opti.disallowed 1
    setprop persist.vendor.pps.disallowed 1
    setprop persist.vendor.cp.disallowed 1
    setprop persist.vendor.ctm.disallowed 1
    setprop persist.vendor.std_pd.disallowed 1
    setprop persist.vendor.tb.disallowed 1

    # VIVO_CHG add permission.
    chown system system /sys/class/backlight/panel0-backlight/brightness
    chown system system /sys/class/backlight/panel0-backlight/max_brightness
    # VIVO_CHG add for second screen : flod / flip project:
    chown system system /sys/class/backlight/panel1-backlight/brightness
    chown system system /sys/class/backlight/panel1-backlight/max_brightness
    class_start charger

# vivo wuxuelong add for ChargerLog begin
service charger_log /system/bin/charger_log
    user root
    class core
    disabled

on charger_logging
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    wait /dev/block/bootdevice/by-name/cache
    mount ext4 /dev/block/bootdevice/by-name/cache /cache nosuid nodev barrier=1
    start charger_log
    
on charger_logdata
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    wait /dev/block/bootdevice/by-name/logdata
    mount ext4 /dev/block/bootdevice/by-name/logdata /logdata nosuid nodev barrier=1
    setprop sys.bbklog.virtual_ab enable
    start charger_log
# vivo wuxuelong add for ChargerLog end

on property:sys.boot_completed=1
    write /proc/blog/step "init 300"
    bootchart stop
    # Setup per_boot directory so other .rc could start to use it on boot_completed
    exec - system system -- /bin/rm -rf /data/per_boot
    mkdir /data/per_boot 0710 system system encryption=Require key=per_boot_ref

# system server cannot write to /proc/sys files,
# and chown/chmod does not work for /proc/sys/ entries.
# So proxy writes through init.
on property:sys.sysctl.extra_free_kbytes=*
    exec_background -- /system/bin/extra_free_kbytes.sh ${sys.sysctl.extra_free_kbytes}

# Allow users to drop caches
on property:perf.drop_caches=3
    write /proc/sys/vm/drop_caches 3
    setprop perf.drop_caches 0

# "tcp_default_init_rwnd" Is too long!
on property:net.tcp_def_init_rwnd=*
    write /proc/sys/net/ipv4/tcp_default_init_rwnd ${net.tcp_def_init_rwnd}

import /system/etc/init/init-perfetto.rc

# on shutdown
# In device's init.rc, this trigger can be used to do device-specific actions
# before shutdown. e.g disable watchdog and mask error handling

## Daemon processes to be run by init.
##
service ueventd /system/bin/ueventd
    class core
    critical
    seclabel u:r:ueventd:s0
    user root
    shutdown critical

# This service takes care of early initialization of device configuration at
# runtime, like per-SKU settings or sysprops. The service runs before apexd
# bootstrap, which means it can also be used to perform conditional APEX
# activation via selection sysprops (e.g. setting ro.boot.vendor.apex.*).
# The 'ro.vendor.init_dev_config.path' sysprop should be configured at build
# time via PRODUCT_VENDOR_PROPERTIES, and must point to a binary built with
# bootstrap bionic and labeled as 'init_dev_config_exec'.
service init_dev_config ${ro.vendor.init_dev_config.path}
    oneshot
    user system
    seclabel u:r:init_dev_config:s0

service console /system/bin/sh
    class core
    console
    disabled
    user shell
    group shell log readproc
    seclabel u:r:shell:s0
    setenv HOSTNAME console
    shutdown critical

on property:ro.debuggable=1
    # Give writes to the same group for the trace folder on debug builds,
    # it's further protected by selinux policy.
    # The folder is used to store method traces.
    chmod 0773 /data/misc/trace
    # Give writes and reads to anyone for the window trace folder on debug builds,
    # it's further protected by selinux policy.
    chmod 0777 /data/misc/wmtrace
    # Give reads to anyone for the accessibility trace folder on debug builds.
    chmod 0775 /data/misc/a11ytrace

on init && property:ro.debuggable=1
    start console

# Allow other processes to run `snapshotctl` through `init`. This requires
# `set_prop` permission on `snapshotctl_prop`.
on property:sys.snapshotctl.map=requested
    # "root" is needed to talk to gsid and pass its check on uid.
    # "system" is needed to write to "/dev/socket/snapuserd" to talk to
    # snapuserd.
    exec - root root system -- /system/bin/snapshotctl map
    setprop sys.snapshotctl.map "finished"

on property:sys.snapshotctl.unmap=requested
    exec - root root system -- /system/bin/snapshotctl unmap
    setprop sys.snapshotctl.unmap "finished"

# vivo guozhangku add for load yzfswj prop begin
on property:persist.vivo.load.yzfswj.prop=true
    load_props /data/preload/yzfswj.prop
    load_props /data/vivo-app/yzfswj.prop
# vivo guozhangku add for load yzfswj prop end

# vivo yuanjianchun add for vgc begin
on property:ro.product.country.region=*
    load_vgc_extra_props all

on property:persist.product.carrier.name=*
    load_vgc_extra_props carrier
# vivo yuanjianchun add for vgc end
# vivo weironghai add for cota begin
on post-fs-data
    start cotamnt
    mount_cota

on property:sys.cota_vgc.mount_trigger=1 && property:sys.cota_vgc=1
    mount_cota

on property:sys.cota_vgc=1
    setprop sys.cota_vgc.action default
    start cotamnt

on property:sys.cota_vgc=2
    setprop sys.cota_vgc.action rollback
    exec u:r:installd:s0 -- /system/bin/cotamnt
    #after cota reset,clear clientid
    rm  /data/vivo-common/cota-persist/clientid.prop

service cotamnt /system/bin/cotamnt
    user root
    class main
    oneshot
    disabled
# vivo weironghai add for cota end

# vivo liweihong add for vtrust begin
on property:sys.vtrust.setupwizard.force_network=1
    setprop ro.setupwizard.require_network any
    setprop ro.setupwizard.user_req_network any
# vivo liweihong add for vtrust end

