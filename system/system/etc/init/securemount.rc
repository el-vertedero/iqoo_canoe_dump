on init
    securemount --type=preAllocate

on post-fs-data && property:ro.vivo.dyn.support=yes
    securemount --type=dyn

on post-fs-data && property:ro.vivo.vendor.dyn.support=yes
    securemount --type=vendor_dyn

on load-bpf-programs
    securemount --type=checkEio

on load_bpf_programs
    securemount --type=checkEio

on property:ro.vivo.dyn.veritystate=*
    load_props /system/dyn/dyn.prop
    setprop ro.vendor.defend.dyn.name ${ro.vivo.dyn.name}
    setprop ro.vendor.defend.dyn.device.name ${ro.vivo.dyn.device.name}
    setprop ro.vendor.defend.dyn.mount.ready 1

on property:ro.vivo.vendor_dyn.veritystate=*
    load_props /vendor/dyn/vendor_dyn.prop
    setprop ro.vendor.defend.vendor_dyn.name ${ro.vivo.vendor.dyn.name}
    setprop ro.vendor.defend.vendor_dyn.mount.ready 1
