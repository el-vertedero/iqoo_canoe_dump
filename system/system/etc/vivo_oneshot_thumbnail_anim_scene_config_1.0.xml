<?xml version="1.0" encoding="utf-8"?>
<OneShotSceneConfig key="oneshot_scene_config_list" version="25121001">
    <!-- 添加配置格式参考 -->
    <!--
        attributeName 描述：
            model name: 适配的项目集合，使用 '-' 进行分隔
            processName：应用进程包名
            activityFrom：当前 Activity 组件名，不支持直接配通配符'*'
            viewFrom：当前点击触发动效的 View 类名
            activityTo：要启动的目标 Activity 组件名
            flags：场景匹配时的特征属性，使用 '|' 进行分隔，如 FLAG_IGNORE_MAX_SIZE 表示忽略 View 的尺寸上限

        例如：
        <application processName="com.ss.android.article.video">
            <model name="PD2405-PD2405F-PD2502" />
            <scene
                activityFrom="com.ss.android.article.video.activity.SplashActivity"
                viewFrom="com.ixigua.commonui.view.pullrefresh.FeedPullRefreshRecyclerView"
                activityTo="*"
                flags="FLAG_DEFAULT|FLAG_IGNORE_MAX_SIZE" />
        </application>
    -->

    <!-- flag具体设置 -->
    <!--
        public static final int FLAG_MATCH_BACK_KEY           = 1 << 0; // 退出重载动画需要应用点击back键，手势之类的退出不重载动画
        public static final int FLAG_CAPTURE_ON_CLICKED       = 1 << 1; // 部分应用比如腾讯视频，是在子线程启动activity，需要在点击的时候截取View信息
        public static final int FLAG_IGNORE_MIN_SIZE          = 1 << 2; // 点击的View太小不重载动画
        public static final int FLAG_IGNORE_MAX_SIZE          = 1 << 3; // 点击的View太大不重载动画
        public static final int FLAG_DISABLE_BLUR             = 1 << 4; // 动画关闭背景模糊
        public static final int FLAG_IGNORE_ASPECT            = 1 << 5; // 点击的View要是一个图块，而不是一个长条
        public static final int FLAG_DISABLE_SPLIT_BLUR       = 1 << 6; // 单独关闭分分屏下动画的背景模糊
        public static final int FLAG_DEFAULT                 = FLAG_MATCH_BACK_KEY;
    -->

