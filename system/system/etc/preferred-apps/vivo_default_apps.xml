<?xml version="1.0" encoding="UTF-8"?>
<preferred-activities>

    <item name="com.android.launcher3/.Launcher">
        <filter>
            <action name="android.intent.action.MAIN" />
            <cat name="android.intent.category.HOME" />
            <cat name="android.intent.category.DEFAULT" />
        </filter>
    </item>

    <item name="com.android.storagemanager/.deletionhelper.DeletionHelperActivity">
        <filter>
            <action name="android.os.storage.action.MANAGE_STORAGE" />
            <cat name="android.intent.category.DEFAULT" />
        </filter>
    </item>

    <item name="com.google.android.contacts/com.android.contacts.activities.PeopleActivity">
        <filter>
            <action name="android.intent.action.VIEW" />
            <cat name="android.intent.category.DEFAULT" />
            <type name="vnd.android.cursor.dir/person"/>
        </filter>
    </item>

</preferred-activities>
