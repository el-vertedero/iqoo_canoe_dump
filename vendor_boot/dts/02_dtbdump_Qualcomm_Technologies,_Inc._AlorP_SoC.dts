		arbiter@c400000 {
			compatible = "qcom,canoe-spmi-pmic-arb";
			reg = <0x00 0xc400000 0x00 0x3000 0x00 0xc900000 0x00 0x400000 0x00 0xc4c0000 0x00 0x400000 0x00 0xc403000 0x00 0x8000>;
			reg-names = "core\0chnls\0obsrvr\0chnl_map";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;
			qcom,channel = <0x00>;
			qcom,ee = <0x00>;
			phandle = <0x10f>;

			spmi@c426000 {
				reg = <0x00 0xc426000 0x00 0x4000 0x00 0xc8c0000 0x00 0x10000 0x00 0xc42a000 0x00 0x8000>;
				reg-names = "cnfg\0intr\0chnl_owner";
				interrupts-extended = <0x30 0x01 0x04>;
				interrupt-names = "periph_irq";
				interrupt-controller;
				#interrupt-cells = <0x04>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;
				phandle = <0x4a1>;
			};

			spmi@c437000 {
				reg = <0x00 0xc437000 0x00 0x4000 0x00 0xc8d0000 0x00 0x10000 0x00 0xc43b000 0x00 0x8000>;
				reg-names = "cnfg\0intr\0chnl_owner";
