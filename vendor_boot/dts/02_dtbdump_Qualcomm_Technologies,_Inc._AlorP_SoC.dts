/dts-v1/;

/ {
	model = "Qualcomm Technologies, Inc. AlorP SoC";
	compatible = "qcom,alorp";
	qcom,msm-id = <0x2d7 0x10000>;
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	qcom,board-id = <0x00 0x00>;

	memory {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x00>;
	};

	chosen {
		bootargs = "loglevel=6 kpti=0 loop.max_part=7 log_buf_len=512K sysctl.kernel.panic_on_rcu_stall=1 msm_rtb.filter=0x237  disable_dma32=on rcupdate.rcu_expedited=1 rcu_nocbs=0-7 ftrace_dump_on_oops cpufreq.default_governor=performance printk.console_no_auto_verbose=1 irqaffinity=0-1 swiotlb=0 kasan=off cgroup_disable=pressure cgroup.memory=nokmem,nosocket page_poison=on restrict_cma_redirect=false fw_devlink.strict=1 kasan=off can.stats_timer=0 android_arch_task_struct_size=512 pcie_ports=compat sysctl.kernel.sched_pelt_multiplier=4 no-steal-acc pci-msm-drv.pcie_sm_regs=0x1D07000,0x1040,0x1048,0x3000,0x1";
		stdout-path = "/soc/qcom,qupv3_1_geni_se@ac0000/qcom,qup_uart@a9c000:115200n8";
		phandle = <0x37f>;
	};

	aliases {
		swr4 = "/soc/spf_core_platform/lpass_bt_swr@6CA0000/bt_swr_mstr";
		swr2 = "/soc/spf_core_platform/lpass-cdc/va-macro@7660000/va_swr_master";
		swr1 = "/soc/spf_core_platform/lpass-cdc/rx-macro@6AC0000/rx_swr_master";
		swr0 = "/soc/spf_core_platform/lpass-cdc/wsa-macro@6B00000/wsa_swr_master";
		mmc1 = "/soc/sdhci@8804000";
		serial0 = "/soc/qcom,qupv3_1_geni_se@ac0000/qcom,qup_uart@a9c000";
		ufshc1 = "/soc/ufshc@1d84000";
		hsuart0 = "/soc/qcom,qupv3_2_geni_se@8c0000/qcom,qup_uart@898000";
		hsuart4 = "/soc/qcom,qupv3_2_geni_se@8c0000/qcom,qup_uart@880000";
		i2c0 = "/soc/qcom,qupv3_1_geni_se@ac0000/i2c@a80000";
		i2c1 = "/soc/qcom,qupv3_1_geni_se@ac0000/i2c@a84000";
		i2c2 = "/soc/qcom,qupv3_1_geni_se@ac0000/i2c@a88000";
