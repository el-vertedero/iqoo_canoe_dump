/dts-v1/;

/ {
	model = "Qualcomm Technologies, Inc. Alor QRD + WCN7750 WLAN + Kundu PD2527";
	compatible = "qcom,alor-qrd\0qcom,alor\0qcom,qrd";
	qcom,msm-id = <0x2ad 0x10000>;
	qcom,board-id = <0x1000b 0x03>;

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {

			qcom,pmk8550@0 {
				compatible = "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				sdam@7000 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7000>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0x54>;

					smb1510_present@5d {
						reg = <0x5d 0x01>;
						bits = <0x05 0x01>;
						phandle = <0x1f>;
					};

					ocp-log@76 {
						reg = <0x76 0x06>;
						phandle = <0x0f>;
					};
				};

				sdam@7100 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7100>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0x55>;

					restart@48 {
						reg = <0x48 0x01>;
						bits = <0x01 0x07>;
						phandle = <0x1b>;
					};

					wr_thermal-flag@58 {
						reg = <0x58 0x01>;
						phandle = <0x56>;
					};

					alarm-log@76 {
						reg = <0x76 0x06>;
						phandle = <0x57>;
					};

					fmd-set@9a {
						reg = <0x9a 0x01>;
						phandle = <0x58>;
					};

					fmd-chg-pon@9f {
						reg = <0x9f 0x01>;
						phandle = <0x59>;
					};

					fmd-cnt2-stop@a2 {
						reg = <0xa2 0x01>;
						phandle = <0x5a>;
					};

					bob1-off-mode-enable@50 {
						reg = <0x50 0x01>;
						phandle = <0x5b>;
					};

					xo_calib-data@59 {
						reg = <0x59 0x01>;
						phandle = <0x5c>;
					};
				};

				sdam@7400 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7400>;
					phandle = <0x0d>;
				};

				sdam@7500 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7500>;
					phandle = <0x0e>;
				};

				sdam@7c00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7c00>;
					phandle = <0x1c>;
				};

				sdam@7d00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7d00>;
					phandle = <0x1d>;
				};

				sdam@8400 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8400>;
					phandle = <0x09>;
				};

				sdam@8500 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8500>;
					phandle = <0x0a>;
				};

				sdam@9800 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9800>;
					phandle = <0x1e>;
				};

				sdam@9a00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9a00>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0x5d>;

					sqm-timer@b8 {
						reg = <0xb8 0x02>;
						phandle = <0x5e>;
					};
				};

				sdam@9d00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9d00>;
					phandle = <0x5f>;
				};

				sdam@b600 {
					compatible = "qcom,spmi-sdam";
					reg = <0xb600>;
					phandle = <0x60>;

					usb-mode@50 {
						reg = <0x50 0x01>;
						phandle = <0x32>;
					};
				};

				pon_hlos@1300 {
					compatible = "qcom,pm8998-pon";
					reg = <0x1300 0x800>;
					reg-names = "pon_hlos\0pon_pbs";

					pwrkey {
						compatible = "qcom,pmk8350-pwrkey";
						interrupts = <0x00 0x13 0x07 0x03>;
						linux,code = <0x74>;
					};

					resin {
						compatible = "qcom,pmk8350-resin";
						interrupts = <0x00 0x13 0x06 0x03>;
						linux,code = <0x72>;
					};
				};

				pinctrl@b800 {
					compatible = "qcom,pmk8550-gpio";
					reg = <0xb800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					pinctrl-0 = <0x01>;
					pinctrl-names = "default";
					phandle = <0x61>;

					div_clk {

						div_clk_default {
							pins = "gpio3";
							function = "func2";
							input-disable;
							output-enable;
							bias-disable;
							power-source = <0x00>;
							phandle = <0x01>;
						};
					};
				};

				rtc@6100 {
					compatible = "qcom,pmk8350-rtc";
					reg = <0x6100 0x6200>;
					reg-names = "rtc\0alarm";
					interrupts = <0x00 0x62 0x01 0x01>;
					phandle = <0x62>;
				};

				pmk8550-pwm {
					compatible = "qcom,pmk8550-pwm";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#pwm-cells = <0x02>;
				};

				vadc@9000 {
					compatible = "qcom,spmi-adc5-gen3";
					reg = <0x9000 0x9100>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupt-names = "adc-sdam0\0adc-sdam1";
					interrupts = <0x00 0x90 0x01 0x01 0x00 0x91 0x01 0x01>;
					#thermal-sensor-cells = <0x01>;
					#io-channel-cells = <0x01>;
					io-channel-ranges;
					pinctrl-0 = <0x02 0x03 0x04 0x05 0x06 0x07>;
					pinctrl-names = "default";
					phandle = <0x08>;

					pmk8550_offset_ref {
						reg = <0x00>;
						label = "pmk8550_offset_ref";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmk8550_vref_1p25 {
						reg = <0x01>;
						label = "pmk8550_vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmk8550_die_temp {
						reg = <0x03>;
						label = "pmk8550_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550_offset_ref {
						reg = <0x100>;
						label = "pm8550_offset_ref";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550_vref_1p25 {
						reg = <0x101>;
						label = "pm8550_vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550_die_temp {
						reg = <0x103>;
						label = "pm8550_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550_vph_pwr {
						reg = <0x18e>;
						label = "pm8550_vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
					};

					pm8550ve_d_die_temp {
						reg = <0x303>;
						label = "pm8550ve_d_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550ve_f_die_temp {
						reg = <0x503>;
						label = "pm8550ve_f_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550ve_g_die_temp {
						reg = <0x603>;
						label = "pm8550ve_g_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550ve_i_die_temp {
						reg = <0x803>;
						label = "pm8550ve_i_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmk8550_sys_therm_0 {
						reg = <0x44>;
						label = "pmk8550_sys_therm_0";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pm8550_ltepa_ntc {
						reg = <0x147>;
						label = "pm8550_ltepa_ntc";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pm8550_quiet_therm {
						reg = <0x144>;
						label = "pm8550_quiet_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pm8550_sys_therm_5 {
						reg = <0x14a>;
						label = "pm8550_sys_therm_5";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pm8550_bat_btb_therm {
						reg = <0x145>;
						label = "pm8550_bat_btb_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pm8550_ap_therm {
						reg = <0x149>;
						label = "pm8550_ap_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pm8550_nrpa_ntc {
						reg = <0x148>;
						label = "pm8550_nrpa_ntc";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pm8550_wlan_therm {
						reg = <0x146>;
						label = "pm8550_wlan_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pmiv010x_ref_gnd {
						reg = <0x700>;
						label = "pmiv010x_ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmiv010x_vref_1p25 {
						reg = <0x701>;
						label = "pmiv010x_vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmiv010x_die_temp {
						reg = <0x703>;
						label = "pmiv010x_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmiv010x_vph_pwr {
						reg = <0x78e>;
						label = "pmiv010x_vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
					};

					pmiv010x_vbat_sns_qbg {
						reg = <0x78f>;
						label = "pmiv010x_vbat_sns";
						qcom,pre-scaling = <0x01 0x03>;
					};

					pmiv010x_chg_temp {
						reg = <0x710>;
						label = "pmiv010x_chg_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmiv010x_batt_therm {
						reg = <0x744>;
						label = "pmiv010x_batt_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pmiv010x_bat_board_therm {
						reg = <0x74b>;
						label = "pmiv010x_bat_board_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pmiv010x_bat_board1_ntc {
						reg = <0x74d>;
						label = "pmiv010x_bat_board1_ntc";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pmiv010x_bat_id {
						reg = <0x745>;
						label = "pmiv010x_bat_id";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,scale-fn-type = <0x18>;
					};

					pmiv010x_iin_fb {
						reg = <0x717>;
						label = "pmiv010x_iin_fb";
					};

					pmiv010x_ichg_fb {
						reg = <0x7a1>;
						label = "pmiv010x_ichg_fb";
					};

					pmiv010x_chg_ic_therm {
						reg = <0x749>;
						label = "pmiv010x_chg_ic_therm";
						qcom,adc-tm-type = <0x01>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmiv010x_usb_con_therm {
						reg = <0x747>;
						label = "pmiv010x_usb_con__therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};
				};
			};

			qcom,pm8550@1 {
				compatible = "qcom,spmi-pmic";
				reg = <0x01 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pm8550-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x01 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <0x08 0x103>;
					io-channel-names = "thermal";
					phandle = <0x10>;
				};

				pinctrl@8800 {
					compatible = "qcom,pm8550-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x0c>;

					sys_therm_5_gpio3 {

						sys_therm_5_gpio3_default {
							pins = "gpio3";
							bias-high-impedance;
							phandle = <0x02>;
						};
					};

					sys_therm_12_gpio2 {

						sys_therm_12_gpio2_default {
							pins = "gpio2";
							bias-high-impedance;
							phandle = <0x03>;
						};
					};

					flash_light_therm_gpio4 {

						flash_light_therm_gpio4_default {
							pins = "gpio4";
							bias-high-impedance;
							phandle = <0x06>;
						};
					};

					key_vol_up {

						key_vol_up_default {
							pins = "gpio6";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x01>;
							phandle = <0x0b>;
						};
					};

					usb_conn_pro {

						usb_conn_pro_default {
							pins = "gpio9";
							function = "normal";
							power-source = <0x00>;
							output-low;
							phandle = <0x53>;
						};
					};
				};

				led-controller {
					compatible = "qcom,pm8350c-pwm";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#pwm-cells = <0x02>;
					nvmem = <0x09 0x0a>;
					nvmem-names = "lpg_chan_sdam\0lut_sdam";

					led@1 {
						reg = <0x01>;
						color = <0x01>;
						label = "red";
					};

					led@2 {
						reg = <0x02>;
						color = <0x02>;
						label = "green";
					};

					led@3 {
						reg = <0x03>;
						color = <0x03>;
						label = "blue";
					};
				};

				bcl@4700 {
					compatible = "qcom,bcl-v5";
					reg = <0x4700 0x100>;
					interrupts = <0x01 0x47 0x00 0x00 0x01 0x47 0x01 0x00 0x01 0x47 0x02 0x00>;
					interrupt-names = "bcl-lvl0\0bcl-lvl1\0bcl-lvl2";
					qcom,pmic7-threshold;
					#thermal-sensor-cells = <0x01>;
					qcom,vbat-deglitch0 = <0x07 0x03 0x01>;
					qcom,vbat-deglitch1 = <0x02 0x01 0x01>;
					qcom,vbat0 = <0x16 0x0e 0x06>;
					qcom,vbat1 = <0x1a 0x16 0x06>;
					phandle = <0x27>;
				};

				led-controller@ee00 {
					compatible = "qcom,pm8550-flash-led\0qcom,spmi-flash-led";
					reg = <0xee00>;
					status = "ok";
					phandle = <0x63>;

					led-0 {
						function = "flash";
						color = <0x06>;
						led-sources = <0x01 0x04>;
						led-max-microamp = <0x493e0>;
						flash-max-microamp = <0x1e8480>;
						flash-max-timeout-us = <0x138800>;
						function-enumerator = <0x00>;
						phandle = <0x64>;
					};

					led-1 {
						function = "flash";
						color = <0x00>;
						led-sources = <0x02 0x03>;
						led-max-microamp = <0x493e0>;
						flash-max-microamp = <0x1e8480>;
						flash-max-timeout-us = <0x138800>;
						function-enumerator = <0x01>;
						phandle = <0x65>;
					};

					led-2 {
						function = "flash";
						color = <0x04>;
						led-sources = <0x01 0x02 0x03 0x04>;
						led-max-microamp = <0x493e0>;
						flash-max-microamp = <0x1e8480>;
						flash-max-timeout-us = <0x138800>;
						function-enumerator = <0x02>;
						phandle = <0x66>;
					};
				};

				qcom,flash_led@ee00 {
					compatible = "qcom,qti-pm8350c-flash-led";
					reg = <0xee00>;
					interrupts = <0x01 0xee 0x00 0x01 0x01 0xee 0x03 0x01 0x01 0xee 0x04 0x01>;
					interrupt-names = "led-fault-irq\0all-ramp-down-done-irq\0all-ramp-up-done-irq";
					qcom,thermal-derate-current = <0xc8 0x1f4>;
					status = "disabled";
					phandle = <0x67>;

					qcom,flash_0 {
						label = "flash";
						qcom,led-name = "led:flash_0";
						qcom,max-current-ma = <0x5dc>;
						qcom,default-led-trigger = "flash0_trigger";
						qcom,id = <0x00>;
						qcom,duration-ms = <0x500>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x68>;
					};

					qcom,flash_1 {
						label = "flash";
						qcom,led-name = "led:flash_1";
						qcom,max-current-ma = <0x5dc>;
						qcom,default-led-trigger = "flash1_trigger";
						qcom,id = <0x01>;
						qcom,duration-ms = <0x500>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x69>;
					};

					qcom,flash_2 {
						label = "flash";
						qcom,led-name = "led:flash_2";
						qcom,max-current-ma = <0x5dc>;
						qcom,default-led-trigger = "flash2_trigger";
						qcom,id = <0x02>;
						qcom,duration-ms = <0x500>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x6a>;
					};

					qcom,flash_3 {
						label = "flash";
						qcom,led-name = "led:flash_3";
						qcom,max-current-ma = <0x5dc>;
						qcom,default-led-trigger = "flash3_trigger";
						qcom,id = <0x03>;
						qcom,duration-ms = <0x500>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x6b>;
					};

					qcom,torch_0 {
						label = "torch";
						qcom,led-name = "led:torch_0";
						qcom,max-current-ma = <0x1f4>;
						qcom,default-led-trigger = "torch0_trigger";
						qcom,id = <0x00>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x6c>;
					};

					qcom,torch_1 {
						label = "torch";
						qcom,led-name = "led:torch_1";
						qcom,max-current-ma = <0x1f4>;
						qcom,default-led-trigger = "torch1_trigger";
						qcom,id = <0x01>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x6d>;
					};

					qcom,torch_2 {
						label = "torch";
						qcom,led-name = "led:torch_2";
						qcom,max-current-ma = <0x1f4>;
						qcom,default-led-trigger = "torch2_trigger";
						qcom,id = <0x02>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x6e>;
					};

					qcom,torch_3 {
						label = "torch";
						qcom,led-name = "led:torch_3";
						qcom,max-current-ma = <0x1f4>;
