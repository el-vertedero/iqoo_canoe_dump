	fragment@36 {
		target = <0xffffffff>;

		__overlay__ {
			status = "ok";
			qcom,clk-freq-out = <0x186a0>;

			vfcs_pi@52 {
				compatible = "vivo,vfcs-pi";
				reg = <0x52>;
				vivo,pi-dev-type = <0x02>;
			};

			vfcs_fchg@66 {
				compatible = "vivo,vfcs-cp-0";
				reg = <0x66>;
				vivo,wls-chg-enable;
				vivo,cp-select = <0x01>;
				vivo,cp-reg = <0x13>;
				vivo,fchg-dev-id = <0x00>;
				vivo,ibus-ocp-thr-ma = <0x1770>;
				vivo,fchg-dev-swicth-freq-khz = <0x1f4>;
				vivo,fchg-lpm-always-high-enable;

				sc8550v {
					vivo,device-id = <0x02>;
					vivo,device-name = "sc8550v";
				};
			};
		};
	};

