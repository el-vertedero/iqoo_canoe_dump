		target = <0xffffffff>;

		__overlay__ {
			pinctrl-1 = <0xffffffff 0x212>;
			pinctrl-0 = <0xffffffff 0xffffffff 0xffffffff 0xffffffff>;
			pinctrl-names = "default\0sleep";
			status = "ok";

			jl,picasso-spi {
				spi-max-frequency = <0x17d7840>;
				status = "ok";
				reg = <0x00>;
				compatible = "jl,picasso-spi";
			};
		};
	};
};
