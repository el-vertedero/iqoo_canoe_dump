			bat_encry_swi_gpio {

				bat_encry_swi_default {
					phandle = <0x61>;

					mux {
						pins = "gpio159";
						function = "gpio";
					};

					config {
						pins = "gpio159";
						drive-strength = <0x08>;
						bias-disable;
						output-low;
					};
				};
			};

			vivo_qupv3_se13_i2c {

				vivo_qupv3_se13_i2c_sda_active {
					phandle = <0x53>;

					mux {
						pins = "gpio64";
						function = "qup3_se0_l0";
					};

					config {
						pins = "gpio64";
						drive-strength = <0x08>;
						bias-pull-up;
						qcom,i2c_pull;
					};
				};

				vivo_qupv3_se13_i2c_scl_active {
					phandle = <0x54>;

					mux {
						pins = "gpio65";
						function = "qup3_se0_l1";
					};

					config {
						pins = "gpio65";
						drive-strength = <0x08>;
						bias-pull-up;
						qcom,i2c_pull;
					};
				};

				vivo_qupv3_se13_i2c_sleep {
					phandle = <0x55>;

					mux {
						pins = "gpio64\0gpio65";
						function = "gpio";
					};

					config {
						pins = "gpio64\0gpio65";
						drive-strength = <0x08>;
					};
				};
			};
		};
	};

