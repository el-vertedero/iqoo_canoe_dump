				};

				config {
					pins = "gpio50";
					drive-strength = <0x06>;
					bias-disable;
				};
			};

			tp_spi_clk_sleep {
				phandle = <0x4e>;

				mux {
					pins = "gpio50";
					function = "gpio";
				};

				config {
					pins = "gpio50";
					drive-strength = <0x06>;
					bias-disable;
					output-low;
				};
			};

			tp_spi_cs_active {
				phandle = <0x4b>;

				mux {
					pins = "gpio51";
					function = "qup4_se0_l3";
				};

				config {
					pins = "gpio51";
					drive-strength = <0x06>;
					bias-disable;
				};
			};

			tp_spi_cs_sleep {
				phandle = <0xd6>;

				mux {
					pins = "gpio51";
					function = "gpio";
				};

				config {
					pins = "gpio51";
					drive-strength = <0x06>;
					bias-disable;
					output-high;
				};
			};

			tp_spi_cs_sleep_bias_disable {
				phandle = <0x4f>;

				mux {
					pins = "gpio51";
					function = "gpio";
				};

				config {
					pins = "gpio51";
					drive-strength = <0x06>;
					bias-disable;
				};
			};

			tp_spi_cs_sleep_output_low {
				phandle = <0xd7>;

				mux {
					pins = "gpio51";
					function = "gpio";
				};

				config {
					pins = "gpio51";
					drive-strength = <0x06>;
					bias-disable;
					output-low;
				};
			};

			tp_int_active {
				phandle = <0x50>;

				mux {
					pins = "gpio158";
					function = "gpio";
				};

				config {
					pins = "gpio158";
					drive-strength = <0x06>;
					bias-pull-up;
					input-enable;
				};
			};

			tp_int_pre_active {
				phandle = <0x52>;

				mux {
					pins = "gpio158";
					function = "gpio";
				};

				config {
					pins = "gpio158";
					bias-disable;
					input-enable;
					drive-strength = <0x06>;
				};
			};

			tp_int_suspend {
				phandle = <0x51>;

				mux {
					pins = "gpio158";
					function = "gpio";
				};

				config {
					pins = "gpio158";
					bias-pull-down;
					input-enable;
					drive-strength = <0x06>;
				};
			};
		};
	};

