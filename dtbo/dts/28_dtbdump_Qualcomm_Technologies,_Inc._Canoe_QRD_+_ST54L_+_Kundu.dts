/dts-v1/;

/ {
	model = "Qualcomm Technologies, Inc. Canoe QRD + ST54L + Kundu";
	compatible = "qcom,canoe-qrd\0qcom,canoe\0qcom,canoep-cdp\0qcom,canoep\0qcom,qrd";
	qcom,msm-id = <0x295 0x20000 0x294 0x10000 0x294 0x20000 0x1000294 0x10000 0x295 0x10000 0x1000295 0x10000 0x1000294 0x20000 0x1000295 0x20000>;
	qcom,board-id = <0x0b 0x00>;

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {

			pmk8850@0 {
				compatible = "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmk8850";
				};

				sdam@7000 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7000>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0x40>;

					ocp-log@76 {
						reg = <0x76 0x06>;
						phandle = <0x17>;
					};
				};

				sdam@7100 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7100>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0x41>;

					restart@48 {
						reg = <0x48 0x01>;
						bits = <0x01 0x07>;
						phandle = <0x14>;
					};

					bob1-off-mode-enable@50 {
						reg = <0x50 0x01>;
						phandle = <0x42>;
					};

					xo_calib-data@59 {
						reg = <0x59 0x01>;
						phandle = <0x43>;
					};

					alarm-log@76 {
						reg = <0x76 0x06>;
						phandle = <0x18>;
					};

					fmd-set@9a {
						reg = <0x9a 0x01>;
						phandle = <0x44>;
					};

					fmd_cont_after_pon@9c {
						reg = <0x9c 0x01>;
						phandle = <0x45>;
					};

					fmd-chg-pon@9f {
						reg = <0x9f 0x01>;
						phandle = <0x46>;
					};

					fmd-cnt2-stop@a2 {
						reg = <0xa2 0x01>;
						phandle = <0x47>;
					};
				};

				sdam@7400 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7400>;
					phandle = <0x15>;
				};

				sdam@7500 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7500>;
					phandle = <0x16>;
				};

				sdam@8400 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8400>;
					phandle = <0x0b>;
				};

				sdam@8500 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8500>;
					phandle = <0x0c>;
				};

				sdam@9a00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9a00>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0x48>;

					sqm-timer@b8 {
						reg = <0xb8 0x02>;
						phandle = <0x10>;
					};
				};

				sdam@9d00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9d00>;
					phandle = <0x13>;
				};

				sdam@aa00 {
					compatible = "qcom,spmi-sdam";
					reg = <0xaa00>;
					phandle = <0x0d>;
				};

				sdam@ab00 {
					compatible = "qcom,spmi-sdam";
					reg = <0xab00>;
					phandle = <0x0e>;
				};

				sdam@ac00 {
					compatible = "qcom,spmi-sdam";
					reg = <0xac00>;
					phandle = <0x0f>;
				};

				pon_hlos@1300 {
					compatible = "qcom,pmk8350-pon";
					reg = <0x1300 0x800>;
					reg-names = "hlos\0pbs";

					pwrkey {
						compatible = "qcom,pmk8350-pwrkey";
						interrupts = <0x00 0x13 0x07 0x03>;
						linux,code = <0x74>;
					};

					resin {
						compatible = "qcom,pmk8350-resin";
						interrupts = <0x00 0x13 0x06 0x03>;
						linux,code = <0x72>;
					};
				};

				sdam@a000 {
					compatible = "qcom,spmi-sdam";
					reg = <0xa000>;
					phandle = <0x06>;
				};

				sdam@a100 {
					compatible = "qcom,spmi-sdam";
					reg = <0xa100>;
					phandle = <0x07>;
				};

				sdam@a200 {
					compatible = "qcom,spmi-sdam";
					reg = <0xa200>;
					phandle = <0x08>;
				};

				sdam@b600 {
					compatible = "qcom,spmi-sdam";
					reg = <0xb600>;
					phandle = <0x49>;

					usb-mode@50 {
						reg = <0x50 0x01>;
						phandle = <0x4a>;
					};
				};

				sdam@b700 {
					compatible = "qcom,spmi-sdam";
					reg = <0xb700>;
					phandle = <0x09>;
				};

				pinctrl@b800 {
					compatible = "qcom,pmk8850-gpio";
					reg = <0xb800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					pinctrl-0 = <0x01 0x02>;
					pinctrl-names = "default";
					phandle = <0x4b>;

					div_clk_default {
						pins = "gpio1";
						function = "func2";
						input-disable;
						output-enable;
						bias-disable;
						power-source = <0x01>;
						phandle = <0x02>;
					};

					alt-sleep-clk-default-state {
						pins = "gpio3";
						function = "func1";
						input-disable;
						output-enable;
						power-source = <0x00>;
						phandle = <0x01>;
					};

					lcd-bl-pwm-default-state {
						pins = "gpio5";
						function = "func3";
						input-disable;
						output-enable;
						power-source = <0x00>;
						phandle = <0x4c>;
					};

					xoagg-therm-default-state {
						pins = "gpio7";
						function = "normal";
						bias-high-impedance;
						phandle = <0x04>;
					};

					cam_sensor_mclk1_1p8_active {
						phandle = <0x23c>;
						power-source = <0x00>;
						output-enable;
						function = "func2";
						pins = "gpio2";
					};

					cam_sensor_mclk1_1p8_suspend {
						phandle = <0x23d>;
						bias-high-impedance;
						function = "func2";
						pins = "gpio2";
					};

					cam_sensor_mclk0_1p8_active {
						phandle = <0x246>;
						power-source = <0x00>;
						output-enable;
						function = "func2";
						pins = "gpio8";
					};

					cam_sensor_mclk0_1p8_suspend {
						phandle = <0x247>;
						bias-high-impedance;
						function = "func2";
						pins = "gpio8";
					};
				};

				rtc@6100 {
					compatible = "qcom,pmk8350-rtc";
					reg = <0x6100 0x6200>;
					reg-names = "rtc\0alarm";
					interrupts = <0x00 0x62 0x01 0x01>;
					phandle = <0x4d>;
				};

				pmk8850-pwm {
					compatible = "qcom,pmk8850-pwm\0qcom,pmk8550-pwm";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#pwm-cells = <0x02>;
				};

				vadc@9000 {
					compatible = "qcom,spmi-adc5-gen4";
					reg = <0x9000 0x9100>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x00 0x90 0x01 0x01 0x00 0x91 0x01 0x01>;
					interrupt-names = "adc-sdam0\0adc-sdam1";
					#thermal-sensor-cells = <0x01>;
					#io-channel-cells = <0x01>;
					io-channel-ranges;
					pinctrl-0 = <0x03 0x04 0x05>;
					pinctrl-names = "default";
					phandle = <0x0a>;

					pmk8850_offset_ref {
						reg = <0x00>;
						label = "pmk8850_offset_ref";
					};

					pmk8850_vref_1p25 {
						reg = <0x01>;
						label = "pmk8850_vref_1p25";
					};

					pmk8850_die_temp {
						reg = <0x03>;
						label = "pmk8850_die_temp";
					};

					pmk8850_xo_therm {
						reg = <0x44>;
						label = "pmk8850_xo_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmk8850_xoagg_therm {
						reg = <0x4b>;
						label = "pmk8850_xoagg_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
						status = "ok";
						phandle = <0x4e>;
					};

					pmh0101_offset_ref {
						reg = <0x100>;
						label = "pmh0101_offset_ref";
					};

					pmh0101_vref_1p25 {
						reg = <0x101>;
						label = "pmh0101_vref_1p25";
					};

					pmh0101_die_temp {
						reg = <0x103>;
						label = "pmh0101_die_temp";
					};

					pmh0101_vph_pwr {
						reg = <0x18e>;
						label = "pmh0101_vph_pwr";
					};

					pmh0101_quiet_therm {
						reg = <0x144>;
						label = "pmh0101_quiet_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmh0101_ap_therm {
						reg = <0x145>;
						label = "pmh0101_ap_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmh0101_wlan_therm {
						reg = <0x146>;
						label = "pmh0101_wlan_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmh0101_nrpa_ntc {
						reg = <0x147>;
						label = "pmh0101_nrpa_ntc";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmh0101_qtm_therm {
						reg = <0x14b>;
						label = "pmh0101_qtm_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
						status = "ok";
						phandle = <0x4f>;
					};

					pmh0101_ltepa_ntc {
						reg = <0x149>;
						label = "pmh0101_ltepa_ntc";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmh0110_d_die_temp {
						reg = <0x303>;
						label = "pmh0110_d_die_temp";
					};

					pmh0110_d_vph_pwr {
						reg = <0x38e>;
						label = "pmh0110_d_vph_pwr";
					};

					pmh0110_f_die_temp {
						reg = <0x503>;
						label = "pmh0110_f_die_temp";
					};

					pmh0110_f_vph_pwr {
						reg = <0x58e>;
						label = "pmh0110_f_vph_pwr";
					};

					pmh0110_g_die_temp {
						reg = <0x603>;
						label = "pmh0110_g_die_temp";
					};

					pmh0110_g_vph_pwr {
						reg = <0x68e>;
						label = "pmh0110_g_vph_pwr";
					};

					pmh0110_i_die_temp {
						reg = <0x803>;
						label = "pmh0110_i_die_temp";
					};

					pmh0110_i_vph_pwr {
						reg = <0x88e>;
						label = "pmh0110_i_vph_pwr";
					};

					pmih010x_offset_ref {
						reg = <0x2700>;
						label = "pmih010x_offset_ref";
					};

					pmih010x_vref_1p25 {
						reg = <0x2701>;
						label = "pmih010x_vref_1p25";
					};

					pmih010x_die_temp {
						reg = <0x2703>;
						label = "pmih010x_die_temp";
					};

					pmih010x_vph_pwr {
						reg = <0x278e>;
						label = "pmih010x_vph_pwr";
					};

					pmih010x_vbat_sns_qbg {
						reg = <0x278f>;
						label = "pmih010x_vbat_sns_qbg";
					};

					pmih010x_iin {
						reg = <0x2717>;
						label = "pmih010x_iin";
					};

					pmih010x_ichg_fb {
						reg = <0x27a1>;
						label = "pmih010x_ichg_fb";
					};

					pmih010x_chg_temp {
						reg = <0x2710>;
						label = "pmih010x_chg_temp";
					};

					pmih010x_lite_die_temp {
						reg = <0x2718>;
						label = "pmih010x_lite_die_temp";
					};

					pmih010x_sub_board_therm {
						reg = <0x2744>;
						label = "pmih010x_sub_board_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmih0101_batt_therm {
						reg = <0x148>;
						label = "pmih0101_batt_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmih010x_usb_therm {
						reg = <0x2747>;
						label = "pmih010x_usb_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmih010x_chg_ic_therm {
						reg = <0x274c>;
						label = "pmih010x_chg_ic_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmih010x_bl_therm {
						reg = <0x274a>;
						label = "pmih010x_bl_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};

					pmih010x_sys_therm_8 {
						reg = <0x274d>;
						label = "pmih010x_sys_therm_8";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x01>;
					};
				};

				qcom,power-telemetry-device {
					compatible = "qcom,power-telemetry";
					status = "okay";
					interrupts = <0x00 0xa2 0x01 0x01 0x00 0xa1 0x01 0x01>;
					nvmem = <0x06 0x07 0x08>;
					nvmem-names = "qpt-config-sdam\0qpt-frac-sdam\0qpt-data-sdam";
					#powerzone-cells = <0x01>;
					power-domains = <0xffffffff>;
					phandle = <0x19>;
				};

				qcom,voltage-adj-device {
					compatible = "qcom,vadj";
					phandle = <0x50>;
				};

				btl {
					compatible = "qcom,btl";
					nvmem = <0x09>;
					nvmem-names = "btl-sdam";
				};

				qcom,power-telemetry-data-share-device {
					compatible = "qcom,power-telemetry-data-share";
				};
			};

			pmh0101@1 {
				compatible = "qcom,spmi-pmic";
				reg = <0x01 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmh0101";
				};

				pmh0101-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x01 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <0x0a 0x103>;
					io-channel-names = "thermal";
					phandle = <0x2a>;
				};

				pinctrl@8800 {
					compatible = "qcom,pmh0101-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x51>;

					qtm-therm-default-state {
						pins = "gpio2";
						function = "normal";
						bias-high-impedance;
						phandle = <0x05>;
					};

					pa-therm2-default-state {
						pins = "gpio3";
						function = "normal";
						bias-high-impedance;
						phandle = <0x03>;
					};

					cam-sensor-1p8-rst0-active-state {
						pins = "gpio4";
						function = "normal";
						qcom,drive-strength = <0x02>;
						input-disable;
						output-enable;
						output-high;
						power-source = <0x00>;
						phandle = <0x52>;
					};

					cam-sensor-1p8-rst0-suspend-state {
						pins = "gpio4";
						function = "normal";
						qcom,drive-strength = <0x02>;
						input-disable;
						output-enable;
						output-low;
						phandle = <0x53>;
					};

					cam-pmic-1p8-rst-active-state {
						pins = "gpio6";
						function = "normal";
						qcom,drive-strength = <0x02>;
						input-disable;
						output-enable;
						output-high;
						power-source = <0x02>;
						phandle = <0x54>;
					};

					cam-pmic-1p8-rst-suspend-state {
						pins = "gpio6";
						function = "normal";
						qcom,drive-strength = <0x02>;
						input-disable;
						output-enable;
						output-low;
						phandle = <0x55>;
					};

					pmh0101-bidir-lvl-shifter1-state {
						pins = "gpio11\0gpio12";
						function = "normal";
						bias-high-impedance;
						phandle = <0x56>;
					};

					pmh0101-bidir-lvl-shifter2-state {
						pins = "gpio13\0gpio14";
						function = "normal";
						bias-high-impedance;
						phandle = <0x57>;
					};

					pmh0101-bidir-lvl-shifter3-state {
						pins = "gpio15\0gpio16";
						function = "normal";
						bias-high-impedance;
						phandle = <0x58>;
					};

					pmh0101-bidir-lvl-shifter4-state {
						pins = "gpio17\0gpio18";
						function = "normal";
						bias-high-impedance;
						phandle = <0x59>;
					};
				};

				led-controller {
					compatible = "qcom,pmh0101-pwm\0qcom,pm8350c-pwm";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#pwm-cells = <0x02>;
					nvmem = <0x0b 0x0c>;
					nvmem-names = "lpg_chan_sdam\0lut_sdam";
					phandle = <0x5a>;

					led@1 {
						reg = <0x01>;
						color = <0x01>;
						label = "red";
					};

					led@2 {
						reg = <0x02>;
						color = <0x02>;
						label = "green";
					};

					led@3 {
						reg = <0x03>;
						color = <0x03>;
						label = "blue";
					};
				};

				bcl@4700 {
					compatible = "qcom,pmh0101-bcl-v5";
					reg = <0x4700 0x100>;
					interrupts = <0x01 0x47 0x00 0x00 0x01 0x47 0x01 0x00 0x01 0x47 0x02 0x00>;
					interrupt-names = "bcl-lvl0\0bcl-lvl1\0bcl-lvl2";
					qcom,pmic7-threshold;
					#thermal-sensor-cells = <0x01>;
					phandle = <0x20>;
				};

				led-controller@ee00 {
					compatible = "qcom,pmh0101-flash-led\0qcom,spmi-flash-led";
					reg = <0xee00>;
					phandle = <0x5b>;

					led-0 {
						function = "flash";
						function-enumerator = <0x00>;
						color = <0x06>;
						led-sources = <0x01 0x04>;
						led-max-microamp = <0x7a120>;
						flash-max-microamp = <0x1e8480>;
						flash-max-timeout-us = <0x138800>;
						phandle = <0x5c>;
					};

					led-1 {
						function = "flash";
						function-enumerator = <0x01>;
						color = <0x00>;
						led-sources = <0x02 0x03>;
						led-max-microamp = <0x7a120>;
						flash-max-microamp = <0x1e8480>;
						flash-max-timeout-us = <0x138800>;
						phandle = <0x5d>;
					};

					led-2 {
						function = "flash";
						function-enumerator = <0x02>;
						color = <0x04>;
						led-sources = <0x01 0x02 0x03 0x04>;
						led-max-microamp = <0x7a120>;
						flash-max-microamp = <0x1e8480>;
						flash-max-timeout-us = <0x138800>;
						phandle = <0x5e>;
